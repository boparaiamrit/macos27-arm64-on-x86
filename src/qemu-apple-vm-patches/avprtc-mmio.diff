+/*
+ * AVP RTC diagnostic register storage, adapted from Yahia's GPL-2.0-or-later
+ * implementation in tqmane/qemu-vphone commit
+ * 4671e2ba6a39e5998446d35ac93dd746f5ef6f47 (2026-10-14).
+ * Register semantics are unknown. This is zeroed per-machine storage only:
+ * no host time, PL031 identity, clock advancement or success bits are invented.
+ * Golden 26A428 iBootStage2 was observed reading offset 0x40.
+ */
+static bool vmapple_avp_rtc_valid(hwaddr addr, unsigned size)
+{
+    return (size == 4 || size == 8) && !(addr & (size - 1)) &&
+           addr <= 0x1000 - size;
+}
+
+static bool vmapple_avp_rtc_accepts(void *opaque, hwaddr addr, unsigned size,
+                                    bool is_write, MemTxAttrs attrs)
+{
+    bool valid = vmapple_avp_rtc_valid(addr, size);
+
+    if (!valid) {
+        qemu_log_mask(LOG_UNIMP,
+                      "avp-rtc: rejected %s offset=0x%" HWADDR_PRIx
+                      " width=%u\n", is_write ? "write" : "read", addr, size);
+    }
+    return valid;
+}
+
+static uint64_t vmapple_avp_rtc_read(void *opaque, hwaddr addr, unsigned size)
+{
+    VMAppleMachineState *vms = opaque;
+    CPUState *cs = current_cpu;
+    uint64_t value;
+
+    if (!vmapple_avp_rtc_valid(addr, size)) {
+        return 0;
+    }
+    value = ldn_le_p(&vms->avp_rtc_regs[addr], size);
+    qemu_log_mask(LOG_UNIMP,
+                  "avp-rtc: read offset=0x%" HWADDR_PRIx
+                  " width=%u value=0x%" PRIx64 " cpu=%d pc=0x%" PRIx64 "\n",
+                  addr, size, value, cs ? cs->cpu_index : -1,
+                  cs ? cpu_env(cs)->pc : 0);
+    return value;
+}
+
+static void vmapple_avp_rtc_write(void *opaque, hwaddr addr, uint64_t value,
+                                 unsigned size)
+{
+    VMAppleMachineState *vms = opaque;
+    CPUState *cs = current_cpu;
+
+    if (!vmapple_avp_rtc_valid(addr, size)) {
+        return;
+    }
+    qemu_log_mask(LOG_UNIMP,
+                  "avp-rtc: write offset=0x%" HWADDR_PRIx
+                  " width=%u value=0x%" PRIx64 " cpu=%d pc=0x%" PRIx64 "\n",
+                  addr, size, value, cs ? cs->cpu_index : -1,
+                  cs ? cpu_env(cs)->pc : 0);
+    stn_le_p(&vms->avp_rtc_regs[addr], size, value);
+}
+
+static const MemoryRegionOps vmapple_avp_rtc_ops = {
+    .read = vmapple_avp_rtc_read,
+    .write = vmapple_avp_rtc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 8,
+    .valid.unaligned = true,
+    .valid.accepts = vmapple_avp_rtc_accepts,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 8,
+    .impl.unaligned = false,
+};
+
