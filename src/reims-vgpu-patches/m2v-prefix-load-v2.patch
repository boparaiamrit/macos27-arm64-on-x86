+/// A `<2 x float>` read at offset 0 of an aggregate led by `<4 x float>` is that vector's first two
+/// lanes in their own type: the shuffle yields the result directly, with no bitcast of a value to its
+/// own type (which SPIR-V rejects).
+#[test]
+fn native_leading_vector_aggregate_load_keeps_same_type_prefix() {
+    let ll = r#"
+target triple = "spirv-unknown-vulkan1.2"
+%struct.wide = type { <4 x float>, [16 x i8] }
+define <2 x float> @load_leading_pair(<4 x float> %value) {
+entry:
+  %w = alloca %struct.wide, align 16
+  store <4 x float> %value, ptr %w, align 16
+  %p = load <2 x float>, ptr %w, align 16
+  ret <2 x float> %p
+}
+"#;
+    let spv = emit_vulkan_spirv(ll).expect("native emit");
+    let module = load_bytes(&spv).expect("load native spv");
+    let float4 = float_vector_type(&module, 32, 4).expect("float4 type");
+    let float2 = float_vector_type(&module, 32, 2).expect("float2 type");
+    let body: Vec<&Instruction> = module
+        .functions
+        .iter()
+        .flat_map(|function| function.all_inst_iter())
+        .collect();
+    assert!(
+        body.iter().all(|inst| inst.class.opcode != Op::Bitcast),
+        "{body:?}"
+    );
+    let shuffle = body
+        .iter()
+        .copied()
+        .find(|inst| inst.class.opcode == Op::VectorShuffle)
+        .expect("lane prefix shuffle");
+    assert_eq!(shuffle.result_type, Some(float2), "{shuffle:?}");
+    assert_eq!(
+        &shuffle.operands[2..],
+        &[Operand::LiteralBit32(0), Operand::LiteralBit32(1)],
+        "{shuffle:?}"
+    );
+    let Some(Operand::IdRef(loaded)) = shuffle.operands.first() else {
+        panic!("shuffle source: {shuffle:?}");
+    };
+    assert!(
+        body.iter().any(|inst| inst.result_id == Some(*loaded)
+            && inst.class.opcode == Op::Load
+            && inst.result_type == Some(float4)),
+        "the prefix comes from the loaded leading vector: {body:?}"
+    );
+    assert!(
+        body.iter().any(|inst| inst.class.opcode == Op::ReturnValue
+            && inst.operands == [Operand::IdRef(shuffle.result_id.expect("shuffle id"))]),
+        "the shuffled prefix is the loaded value: {body:?}"
+    );
+}
