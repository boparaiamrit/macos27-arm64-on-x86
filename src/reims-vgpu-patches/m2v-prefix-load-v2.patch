+/// Result id of `OpTypeVector` over an `OpTypeFloat` of `bits`, with `lanes` components.
+fn float_vector_type(module: &Module, bits: u32, lanes: u32) -> Option<Word> {
+    let declared = |opcode: Op, operands: &[Operand]| {
+        module
+            .types_global_values
+            .iter()
+            .find(|inst| inst.class.opcode == opcode && inst.operands == operands)
+            .and_then(|inst| inst.result_id)
+    };
+    let elem = declared(Op::TypeFloat, &[Operand::LiteralBit32(bits)])?;
+    declared(
+        Op::TypeVector,
+        &[Operand::IdRef(elem), Operand::LiteralBit32(lanes)],
+    )
+}
+
+/// A union lowered as `{ { <4 x float>, <4 x half>, [8 x i8] }, [32 x i8] }`, written through its
+/// leading `<4 x float>` and read back at offset 0 as `<4 x half>`: those 8 bytes are lanes 0 and 1 of
+/// the stored `float4`. Logical addressing cannot re-type the pointer, so the load access-chains to the
+/// leading vector the store wrote, loads it, keeps lanes 0 and 1, and bitcasts that `<2 x float>` to
+/// `<4 x half>`. Without this the emitter fell back with "cannot reinterpret load … non-bitcastable
+/// pointee Struct(…) to Vector(Half, 4)".
+#[test]
+fn native_leading_vector_aggregate_load_reinterprets_narrower_prefix() {
+    let ll = r#"
+target triple = "spirv-unknown-vulkan1.2"
+%struct.pair = type { <4 x float>, <4 x half>, [8 x i8] }
+%union.pun = type { %struct.pair, [32 x i8] }
+define void @k(ptr addrspace(1) %src, ptr addrspace(1) %dst) {
+entry:
+  %u = alloca %union.pun, align 16
+  %value = load <4 x float>, ptr addrspace(1) %src, align 16
+  store <4 x float> %value, ptr %u, align 16
+  %h = load <4 x half>, ptr %u, align 16
+  store <4 x half> %h, ptr addrspace(1) %dst, align 8
+  ret void
+}
+
+!air.kernel = !{!0}
+!0 = !{ptr @k, !1, !2}
+!1 = !{}
+!2 = !{!3, !4}
+!3 = !{i32 0, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read", !"air.address_space", i32 1, !"air.arg_type_size", i32 16, !"air.arg_type_align_size", i32 16, !"air.arg_type_name", !"float4", !"air.arg_name", !"src"}
+!4 = !{i32 1, !"air.buffer", !"air.location_index", i32 1, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_size", i32 8, !"air.arg_type_align_size", i32 8, !"air.arg_type_name", !"half4", !"air.arg_name", !"dst"}
+"#;
+    let spv = emit_vulkan_spirv(ll).expect("native emit");
+    let module = load_bytes(&spv).expect("load native spv");
+    let float4 = float_vector_type(&module, 32, 4).expect("float4 type");
+    let float2 = float_vector_type(&module, 32, 2).expect("float2 type");
+    let half4 = float_vector_type(&module, 16, 4).expect("half4 type");
+    let body: Vec<&Instruction> = module
+        .functions
+        .iter()
+        .flat_map(|function| function.all_inst_iter())
+        .collect();
+    let defining = |id: Word| {
+        body.iter()
+            .copied()
+            .find(|inst| inst.result_id == Some(id))
+            .unwrap_or_else(|| panic!("no definition of %{id}"))
+    };
+    let operand_id = |inst: &Instruction, index: usize| match inst.operands.get(index) {
+        Some(Operand::IdRef(id)) => *id,
+        other => panic!("operand {index} of {inst:?} is not an id: {other:?}"),
+    };
+
+    let cast = body
+        .iter()
+        .copied()
+        .find(|inst| inst.class.opcode == Op::Bitcast && inst.result_type == Some(half4))
+        .expect("half4 is produced by a bitcast");
+    let prefix = defining(operand_id(cast, 0));
+    assert_eq!(prefix.class.opcode, Op::VectorShuffle, "{prefix:?}");
+    assert_eq!(prefix.result_type, Some(float2), "{prefix:?}");
+    assert_eq!(
+        &prefix.operands[2..],
+        &[Operand::LiteralBit32(0), Operand::LiteralBit32(1)],
+        "the half4 is lanes 0 and 1: {prefix:?}"
+    );
+    let loaded = defining(operand_id(prefix, 0));
+    assert_eq!(loaded.class.opcode, Op::Load, "{loaded:?}");
+    assert_eq!(loaded.result_type, Some(float4), "{loaded:?}");
+
+    let store = body
+        .iter()
+        .copied()
+        .find(|inst| {
+            inst.class.opcode == Op::Store
+                && matches!(inst.operands.get(1), Some(Operand::IdRef(object))
+                if body.iter().any(|def| {
+                    def.result_id == Some(*object) && def.result_type == Some(float4)
+                }))
+        })
+        .expect("float4 store");
+    let written = defining(operand_id(store, 0));
+    let read = defining(operand_id(loaded, 0));
+    assert_eq!(read.class.opcode, Op::InBoundsAccessChain, "{read:?}");
+    assert_eq!(
+        read.operands, written.operands,
+        "the load reads the leading vector the store wrote"
+    );
+
+    // The complete kernel (entry point, interface, capabilities) must validate: a `<2 x float>` to
+    // `<4 x half>` bitcast is legal only with equal total width and dividing component counts.
+    let tmp = std::env::temp_dir().join(format!(
+        "metal2vulkan_native_leading_vector_prefix_{}",
+        std::process::id()
+    ));
+    let _ = std::fs::create_dir_all(&tmp);
+    let kernel = crate::translate_sanitized_native(ll, Stage::Kernel, &tmp).expect("translate");
+    if std::process::Command::new("spirv-val")
+        .arg("--version")
+        .output()
+        .is_ok()
+    {
+        tools::spirv_val_bytes(&kernel, &tmp).expect("spirv-val");
+    }
+    let _ = std::fs::remove_dir_all(&tmp);
+}
