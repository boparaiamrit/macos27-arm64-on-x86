+/// The leading lanes of `vector_ty` that a narrower numeric-vector load of `result_ty` at the
+/// vector's address reads: `Some((k, prefix_ty))` when the result is exactly `k` whole lanes with
+/// `2 <= k < lanes`, so its bits are the bits of lanes `0..k`; `prefix_ty` is `<k x elem>`. `None`
+/// when the result reaches past the vector, splits a lane, or the prefix and the result cannot be
+/// related by one `OpBitcast` (SPIR-V needs one component count to divide the other). A one-lane
+/// result is the first scalar leaf, which `emit_first_scalar_aggregate_reinterpret_load` already
+/// reads without loading the whole vector.
+fn leading_vector_prefix(vector_ty: &LlType, result_ty: &LlType) -> Option<(u32, LlType)> {
+    let (LlType::Vector(elem, lanes), LlType::Vector(result_elem, result_lanes)) =
+        (vector_ty, result_ty)
+    else {
+        return None;
+    };
+    let lane_bits = bitcast_width(elem).filter(|bits| *bits >= 8)?;
+    let result_bits = bitcast_width(result_elem).filter(|bits| *bits >= 8)? * result_lanes;
+    if result_bits % lane_bits != 0 {
+        return None;
+    }
+    let prefix = result_bits / lane_bits;
+    let (fewer, more) = (prefix.min(*result_lanes), prefix.max(*result_lanes));
+    if prefix < 2 || prefix >= *lanes || more % fewer != 0 {
+        return None;
+    }
+    Some((prefix, LlType::Vector(elem.clone(), prefix)))
+}
