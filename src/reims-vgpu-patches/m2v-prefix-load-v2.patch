+/// The same union read through a local pointer into a constant buffer, a device buffer and
+/// threadgroup memory — the shape of the guest's `Local("%N")` operand, whose storage follows its
+/// root. Each read is lanes 0 and 1 of the leading `float4`, bitcast to `<4 x half>`, in a kernel that
+/// validates. Reading the whole leading vector is the over-read `emit_narrowing_vector_load` already
+/// performs for every storage class; the lanes past the result are discarded.
+#[test]
+fn native_leading_vector_aggregate_load_reads_prefix_through_buffer_and_threadgroup_pointers() {
+    let types = "%struct.pair = type { <4 x float>, <4 x half>, [8 x i8] }\n\
+                 %union.pun = type { %struct.pair, [32 x i8] }";
+    let dst = r#"!{i32 1, !"air.buffer", !"air.location_index", i32 1, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_size", i32 8, !"air.arg_type_align_size", i32 8, !"air.arg_type_name", !"half4", !"air.arg_name", !"dst"}"#;
+    let buffer_case = |addrspace: u32, access: &str| {
+        format!(
+            r#"target triple = "spirv-unknown-vulkan1.2"
+{types}
+define void @k(ptr addrspace({addrspace}) %src, ptr addrspace(1) %dst) {{
+entry:
+  %u = getelementptr inbounds %union.pun, ptr addrspace({addrspace}) %src, i64 0
+  %h = load <4 x half>, ptr addrspace({addrspace}) %u, align 16
+  store <4 x half> %h, ptr addrspace(1) %dst, align 8
+  ret void
+}}
+
+!air.kernel = !{{!0}}
+!0 = !{{ptr @k, !1, !2}}
+!1 = !{{}}
+!2 = !{{!3, !4}}
+!3 = !{{i32 0, !"air.buffer", !"air.buffer_size", i32 64, !"air.location_index", i32 0, i32 1, !"{access}", !"air.address_space", i32 {addrspace}, !"air.arg_type_size", i32 64, !"air.arg_type_align_size", i32 16, !"air.arg_type_name", !"pun", !"air.arg_name", !"src"}}
+!4 = {dst}
+"#
+        )
+    };
+    let threadgroup = format!(
+        r#"target triple = "spirv-unknown-vulkan1.2"
+{types}
+@shared = internal addrspace(3) global %union.pun undef, align 16
+define void @k(ptr addrspace(1) %dst) {{
+entry:
+  %u = getelementptr inbounds %union.pun, ptr addrspace(3) @shared, i64 0
+  %h = load <4 x half>, ptr addrspace(3) %u, align 16
+  store <4 x half> %h, ptr addrspace(1) %dst, align 8
+  ret void
+}}
+
+!air.kernel = !{{!0}}
+!0 = !{{ptr @k, !1, !2}}
+!1 = !{{}}
+!2 = !{{!4}}
+!4 = !{{i32 0, !"air.buffer", !"air.location_index", i32 1, i32 1, !"air.write", !"air.address_space", i32 1, !"air.arg_type_size", i32 8, !"air.arg_type_align_size", i32 8, !"air.arg_type_name", !"half4", !"air.arg_name", !"dst"}}
+"#
+    );
+    let tmp = std::env::temp_dir().join(format!(
+        "metal2vulkan_native_leading_vector_prefix_storage_{}",
+        std::process::id()
+    ));
+    let _ = std::fs::create_dir_all(&tmp);
+    for (case, ll) in [
+        ("constant buffer", buffer_case(2, "air.read")),
+        ("device buffer", buffer_case(1, "air.read_write")),
+        ("threadgroup", threadgroup),
+    ] {
+        let spv = emit_vulkan_spirv(&ll).unwrap_or_else(|error| panic!("{case}: {error}"));
+        let module = load_bytes(&spv).expect("load native spv");
+        let float4 = float_vector_type(&module, 32, 4).expect("float4 type");
+        let float2 = float_vector_type(&module, 32, 2).expect("float2 type");
+        let half4 = float_vector_type(&module, 16, 4).expect("half4 type");
+        let body: Vec<&Instruction> = module
+            .functions
+            .iter()
+            .flat_map(|function| function.all_inst_iter())
+            .collect();
+        let defined_by = |operand: Option<&Operand>| match operand {
+            Some(Operand::IdRef(id)) => body
+                .iter()
+                .copied()
+                .find(|inst| inst.result_id == Some(*id))
+                .unwrap_or_else(|| panic!("{case}: no definition of %{id}")),
+            other => panic!("{case}: not an id operand: {other:?}"),
+        };
+        let cast = body
+            .iter()
+            .copied()
+            .find(|inst| inst.class.opcode == Op::Bitcast && inst.result_type == Some(half4))
+            .unwrap_or_else(|| panic!("{case}: half4 is produced by a bitcast"));
+        let prefix = defined_by(cast.operands.first());
+        assert_eq!(
+            (prefix.class.opcode, prefix.result_type),
+            (Op::VectorShuffle, Some(float2)),
+            "{case}: {prefix:?}"
+        );
+        assert_eq!(
+            &prefix.operands[2..],
+            &[Operand::LiteralBit32(0), Operand::LiteralBit32(1)],
+            "{case}: the half4 is lanes 0 and 1"
+        );
+        let loaded = defined_by(prefix.operands.first());
+        assert_eq!(
+            (loaded.class.opcode, loaded.result_type),
+            (Op::Load, Some(float4)),
+            "{case}: {loaded:?}"
+        );
+        let kernel = crate::translate_sanitized_native(&ll, Stage::Kernel, &tmp)
+            .unwrap_or_else(|error| panic!("{case}: translate: {error}"));
+        if std::process::Command::new("spirv-val")
+            .arg("--version")
+            .output()
+            .is_ok()
+        {
+            tools::spirv_val_bytes(&kernel, &tmp)
+                .unwrap_or_else(|error| panic!("{case}: spirv-val: {error}"));
+        }
+    }
+    let _ = std::fs::remove_dir_all(&tmp);
+}
