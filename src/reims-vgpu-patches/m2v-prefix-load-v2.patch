+/// A one-lane result (`<2 x half>` is one `float` wide) is the aggregate's first scalar: it keeps the
+/// single-lane load and bitcast of the first-scalar path instead of loading the whole leading vector.
+#[test]
+fn native_leading_vector_aggregate_load_reads_one_lane_result_as_first_scalar() {
+    let ll = r#"
+target triple = "spirv-unknown-vulkan1.2"
+%struct.wide = type { <4 x float>, [16 x i8] }
+define <2 x half> @load_first_lane(<4 x float> %value) {
+entry:
+  %w = alloca %struct.wide, align 16
+  store <4 x float> %value, ptr %w, align 16
+  %h = load <2 x half>, ptr %w, align 16
+  ret <2 x half> %h
+}
+"#;
+    let module = load_bytes(emit_vulkan_spirv(ll).expect("native emit")).expect("load native spv");
+    let half2 = float_vector_type(&module, 16, 2).expect("half2 type");
+    let float = module
+        .types_global_values
+        .iter()
+        .find(|inst| {
+            inst.class.opcode == Op::TypeFloat && inst.operands == [Operand::LiteralBit32(32)]
+        })
+        .and_then(|inst| inst.result_id)
+        .expect("float type");
+    let body: Vec<&Instruction> = module
+        .functions
+        .iter()
+        .flat_map(|function| function.all_inst_iter())
+        .collect();
+    assert!(
+        body.iter()
+            .all(|inst| inst.class.opcode != Op::VectorShuffle),
+        "{body:?}"
+    );
+    let cast = body
+        .iter()
+        .find(|inst| inst.class.opcode == Op::Bitcast && inst.result_type == Some(half2))
+        .expect("half2 bitcast");
+    let Some(Operand::IdRef(source)) = cast.operands.first() else {
+        panic!("bitcast source: {cast:?}");
+    };
+    assert!(
+        body.iter().any(|inst| inst.result_id == Some(*source)
+            && inst.class.opcode == Op::Load
+            && inst.result_type == Some(float)),
+        "the half2 is the bits of the first float lane: {body:?}"
+    );
+}
