+/// Where one guest build leaves the directed handoff at the producer store.
+///
+/// The three values are what `do_host_mapping_gated` keeps in callee-saved
+/// registers across its iosfc producer write, so the indices are an artifact
+/// of that kext build's register allocation, not of the wire protocol.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct MapperCaptureRegs {
+    pub mapper_device: u32,
+    pub request_type: u32,
+    pub mapping_internal: u32,
+}
+
+/// The baseline handoff the constants above describe.
+pub const MAPPER_CAPTURE_REGS_BASELINE: MapperCaptureRegs = MapperCaptureRegs {
+    mapper_device: MAPPER_CAPTURE_REG_MAPPER_DEVICE,
+    request_type: MAPPER_CAPTURE_REG_REQUEST_TYPE,
+    mapping_internal: MAPPER_CAPTURE_REG_MAPPING_INTERNAL,
+};
+
+/// macOS 27 (26A428) `IOSurfaceParavirtMapperDevice::do_host_mapping_gated`.
+///
+/// Its prologue moves `this` to x19, the request type (w2) to x20 and the
+/// `MappingInternal*` (x1) to x21, and none of the three is reassigned before
+/// `str x8, [x9, #0x1018]`, the producer store. At that store x22 holds the
+/// ring slot's byte offset, which is why the baseline layout reads it there.
+pub const MAPPER_CAPTURE_REGS_MACOS27: MapperCaptureRegs = MapperCaptureRegs {
+    mapper_device: 19,
+    request_type: 20,
+    mapping_internal: 21,
+};
+
+/// Every recovered handoff, in the order a capture tries them.
+///
+/// These are closed contracts recovered from guest builds, not a register
+/// search: a layout is accepted only when its request type equals the ring
+/// entry's and its `MappingInternal*` validates against the entry's mapping id
+/// and the mapper device. A guest none of them describes is refused.
+pub const MAPPER_CAPTURE_LAYOUTS: [MapperCaptureRegs; 2] =
+    [MAPPER_CAPTURE_REGS_BASELINE, MAPPER_CAPTURE_REGS_MACOS27];
+
 pub const ROW_BYTES_ALIGN: u64 = 128;
 pub const DEVICE_PLANE_DESC_LEN: usize = 0x40;
 pub const DEVICE_PLANE_OFFSET: usize = 0x08;
