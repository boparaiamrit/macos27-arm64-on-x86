+/// A MAP for `mapping_id` published at producer 1, with a MappingInternal at
+/// `internal` whose identity names `internal_id` and `mapper` as its owner.
+fn macos27_fixture(ring: u64, mapping_id: u32, internal: u64, internal_id: u32, mapper: u64) -> (DeviceState, FakeHost) {
+    let mut state = DeviceState::new(DeviceId(1), PAGE_SHIFT_ARM64E);
+    let mut host = FakeHost::new();
+    state.iosfc.ring_base = ring;
+    let mut entry = [0u8; 16];
+    st32(&mut entry[0..], MAPPER_REQUEST_MAP);
+    st32(&mut entry[4..], mapping_id);
+    host.map_range(ring, 16, 0);
+    let _ = host.write_gpa(ring, &entry);
+    put_u64(&mut host, internal + MAPPING_INTERNAL_BACKPTR, mapper);
+    put_u32(&mut host, internal + MAPPING_INTERNAL_ID, internal_id);
+    put_u32(&mut host, internal + MAPPING_INTERNAL_SIZE, MAPPING_INTERNAL_EXPECTED_SIZE);
+    // What macOS 27's do_host_mapping_gated holds at the producer store: x19 the
+    // mapper, x20 the request type, x21 the MappingInternal* and x22 the ring
+    // slot's byte offset. The baseline layout therefore reads a kernel pointer
+    // (x21) as the request type.
+    let regs = MAPPER_CAPTURE_REGS_MACOS27;
+    host.set_xreg(regs.mapper_device, mapper);
+    host.set_xreg(regs.request_type, MAPPER_REQUEST_MAP as u64);
+    host.set_xreg(regs.mapping_internal, internal);
+    host.set_xreg(22, 0x10);
+    (state, host)
+}
+
+#[test]
+fn capture_accepts_the_macos27_handoff_layout() {
+    let (internal, mapper) = (KVA + 0x4000, KVA + 0x5000);
+    let (mut state, host) = macos27_fixture(0x7200_0000, 11, internal, 11, mapper);
+    let cap = capture_at_producer(&state, &host, 1).expect("macOS 27 capture");
+    assert_eq!(
+        (cap.mapping_internal, cap.mapper_device_kva, cap.request_type),
+        (internal, mapper, MAPPER_REQUEST_MAP)
+    );
+    assert!(apply_capture(&mut state, &cap, 11));
+    assert_eq!(state.mappings.get(&11).unwrap().mapping_internal, internal);
+}
+
+#[test]
+fn a_layout_whose_internal_names_another_mapping_is_refused() {
+    // The macOS 27 layout corroborates the request type but its MappingInternal
+    // belongs to mapping 99. No layout may accept that, and the miss reported is
+    // the baseline layout's, exactly what this guest logged before it existed.
+    let (state, host) = macos27_fixture(0x7300_0000, 12, KVA + 0x6000, 99, KVA + 0x7000);
+    let seen = |m: u32, r: &'static str| {
+        resolve_fail_latch()
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .contains(&(m, r))
+    };
+    clear_resolve_fail(12);
+    assert!(capture_at_producer(&state, &host, 1).is_none());
+    assert!(seen(12, "mapper_capture_request_type_mismatch"));
+    assert!(!seen(12, "iosurface_validate_mapping_id_mismatch"));
+}
