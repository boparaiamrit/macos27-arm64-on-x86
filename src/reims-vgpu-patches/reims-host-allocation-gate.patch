+/// What `HOST_ALLOCATION_EXT` offers one image shape, asked only where the
+/// extension that spells the handle type is advertised.
+///
+/// [`query`] asks the buffer half of the same question behind the same gate.
+/// The image half is asked by the capability reports in
+/// [`super::linear_sampled`] and [`super::linear_target`], and it used to be
+/// asked unconditionally: naming `HOST_ALLOCATION_EXT` in a
+/// `VkPhysicalDeviceExternalImageFormatInfo` on a device that does not advertise
+/// `VK_EXT_external_memory_host` is invalid usage
+/// (`VUID-VkPhysicalDeviceExternalImageFormatInfo-handleType-parameter`), not a
+/// question whose answer is "no". Mesa's Dozen on Direct3D 12 is such a device,
+/// and the validation layer named the call for every probed format on every
+/// device create. Unasked reads as no import features, which is the truth on
+/// that host: it has no import path for the shape to use.
+///
+/// `ask` makes the `vkGetPhysicalDeviceImageFormatProperties2` call and returns
+/// `None` when the device cannot make the image at all — a "no" for that shape
+/// rather than an error for the boot.
+pub(crate) fn host_allocation_image_features(
+    has_extension: &dyn Fn(&std::ffi::CStr) -> bool,
+    ask: impl FnOnce() -> Option<vk::ExternalMemoryFeatureFlags>,
+) -> vk::ExternalMemoryFeatureFlags {
+    if !has_extension(vk::EXT_EXTERNAL_MEMORY_HOST_NAME) {
+        return vk::ExternalMemoryFeatureFlags::empty();
+    }
+    ask().unwrap_or_default()
+}
