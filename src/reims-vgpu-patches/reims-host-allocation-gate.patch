 /// The largest single host-pointer import this device will ask any driver for,
 /// before the device's own limits narrow it further.
 ///
@@ -548,6 +576,36 @@ mod tests {
             .all(|s| s.bytes().all(|b| b.is_ascii_lowercase() || b == b'_')));
     }
 
+    /// `HOST_ALLOCATION_EXT` is spelled by `VK_EXT_external_memory_host`, so a
+    /// device that does not advertise the extension is not asked about it for
+    /// an image either. Naming it there is invalid usage
+    /// (`VUID-VkPhysicalDeviceExternalImageFormatInfo-handleType-parameter`),
+    /// which Mesa's Dozen reported for every probed format on every device
+    /// create: a validation error, not an answer. The question is the closure,
+    /// and it must not run.
+    #[test]
+    fn the_image_import_question_needs_the_extension_that_spells_its_handle_type() {
+        let importable = vk::ExternalMemoryFeatureFlags::IMPORTABLE;
+        let asked = std::cell::Cell::new(0);
+        let ask = || {
+            asked.set(asked.get() + 1);
+            Some(importable)
+        };
+        let none = |_: &std::ffi::CStr| false;
+        let another = |name: &std::ffi::CStr| name == ash::khr::push_descriptor::NAME;
+        let without: [&dyn Fn(&std::ffi::CStr) -> bool; 2] = [&none, &another];
+        for has_extension in without {
+            assert!(host_allocation_image_features(has_extension, ask).is_empty());
+        }
+        assert_eq!(asked.get(), 0, "a device without the extension was asked");
+
+        let advertised = |name: &std::ffi::CStr| name == vk::EXT_EXTERNAL_MEMORY_HOST_NAME;
+        assert_eq!(host_allocation_image_features(&advertised, ask), importable);
+        assert_eq!(asked.get(), 1);
+        // A device that cannot make the image at all is a "no" for that shape.
+        assert!(host_allocation_image_features(&advertised, || None).is_empty());
+    }
+
     /// A negative rung carries no granularity. A non-zero alignment beside a
     /// refusal is a number an import site could act on, and every one of those
     /// rungs describes a device that would reject the import.
