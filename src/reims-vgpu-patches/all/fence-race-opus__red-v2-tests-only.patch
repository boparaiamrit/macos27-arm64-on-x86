+/// Test instrument: the Khronos validation layer's error reports for this
+/// process, readable by the test that provoked them.
+///
+/// The layer prints to stdout whether or not anyone listens, and the
+/// qualification gate classifies those lines. A test that must *fail* on a
+/// report — a two-thread use of an externally synchronized fence, say — needs
+/// it in-process, so a test build asks for `VK_EXT_debug_utils` when the loader
+/// offers it and keeps every error the layer sends. The layer's own output is
+/// unchanged, and the callback returns `VK_FALSE`, so no call is skipped.
+#[cfg(test)]
+pub(crate) mod validation_capture {
+    use ash::vk;
+    use std::ffi::CStr;
+    use std::sync::Mutex;
+
+    /// One error-severity report.
+    #[derive(Clone, Debug)]
+    pub(crate) struct Report {
+        pub(crate) id: String,
+        pub(crate) message: String,
+        pub(crate) objects: Vec<u64>,
+    }
+
+    static ERRORS: Mutex<Vec<Report>> = Mutex::new(Vec::new());
+
+    /// Every error report captured in this process so far.
+    pub(crate) fn errors() -> Vec<Report> {
+        ERRORS.lock().unwrap_or_else(|e| e.into_inner()).clone()
+    }
+
+    /// Whether the loader offers `VK_EXT_debug_utils` to an instance.
+    pub(super) unsafe fn offered(entry: &ash::Entry) -> bool {
+        unsafe { entry.enumerate_instance_extension_properties(None) }.is_ok_and(|extensions| {
+            extensions.iter().any(|extension| {
+                let name = unsafe { CStr::from_ptr(extension.extension_name.as_ptr()) };
+                name == ash::ext::debug_utils::NAME
+            })
+        })
+    }
+
+    pub(crate) struct Messenger {
+        loader: ash::ext::debug_utils::Instance,
+        messenger: vk::DebugUtilsMessengerEXT,
+    }
+
+    impl Messenger {
+        pub(super) unsafe fn install(entry: &ash::Entry, instance: &ash::Instance) -> Option<Self> {
+            let loader = ash::ext::debug_utils::Instance::new(entry, instance);
+            let info = vk::DebugUtilsMessengerCreateInfoEXT::default()
+                .message_severity(vk::DebugUtilsMessageSeverityFlagsEXT::ERROR)
+                .message_type(
+                    vk::DebugUtilsMessageTypeFlagsEXT::GENERAL
+                        | vk::DebugUtilsMessageTypeFlagsEXT::VALIDATION
+                        | vk::DebugUtilsMessageTypeFlagsEXT::PERFORMANCE,
+                )
+                .pfn_user_callback(Some(record));
+            let messenger = unsafe { loader.create_debug_utils_messenger(&info, None) }.ok()?;
+            Some(Self { loader, messenger })
+        }
+
+        pub(super) unsafe fn destroy(self) {
+            unsafe {
+                self.loader
+                    .destroy_debug_utils_messenger(self.messenger, None)
+            };
+        }
+    }
+
+    unsafe extern "system" fn record(
+        severity: vk::DebugUtilsMessageSeverityFlagsEXT,
+        _types: vk::DebugUtilsMessageTypeFlagsEXT,
+        data: *const vk::DebugUtilsMessengerCallbackDataEXT<'_>,
+        _user: *mut std::ffi::c_void,
+    ) -> vk::Bool32 {
+        if !severity.contains(vk::DebugUtilsMessageSeverityFlagsEXT::ERROR) || data.is_null() {
+            return vk::FALSE;
+        }
+        // No panic may cross this boundary.
+        let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let data = unsafe { &*data };
+            let text = |p: *const std::ffi::c_char| {
+                if p.is_null() {
+                    String::new()
+                } else {
+                    unsafe { CStr::from_ptr(p) }.to_string_lossy().into_owned()
+                }
+            };
+            let objects = if data.p_objects.is_null() {
+                Vec::new()
+            } else {
+                unsafe { std::slice::from_raw_parts(data.p_objects, data.object_count as usize) }
+                    .iter()
+                    .map(|object| object.object_handle)
+                    .collect()
+            };
+            ERRORS
+                .lock()
+                .unwrap_or_else(|e| e.into_inner())
+                .push(Report {
+                    id: text(data.p_message_id_name),
+                    message: text(data.p_message),
+                    objects,
+                });
+        }));
+        vk::FALSE
+    }
+}
