+
+/// Release engine-owned image backing after every view and the image are dead.
+/// The slab ledger is authoritative for shared ranges; an untracked allocation
+/// is dedicated. Guest-import parents have a different owner and never enter.
+unsafe fn release_image_backing(
+    device: &ash::Device,
+    pool: &mut slab::SlabPool,
+    image: vk::Image,
+    memory: vk::DeviceMemory,
+) {
+    let shared = pool.free_image(device, image);
+    if !shared {
+        device.free_memory(memory, None);
+    }
+    #[cfg(test)]
+    eprintln!(
+        "PARENT_IMAGE_BACKING_RELEASE image={:#x} memory={:#x} owner={}",
+        image.as_raw(),
+        memory.as_raw(),
+        if shared { "slab" } else { "dedicated" }
+    );
 }
 
