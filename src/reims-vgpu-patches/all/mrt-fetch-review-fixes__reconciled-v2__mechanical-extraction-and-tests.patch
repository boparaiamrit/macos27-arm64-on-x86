+    use super::*;
+    fn selected_key() -> super::super::caches::PassKey {
+        let mut key = super::super::caches::PassKey::single(
+            super::super::caches::Color0Load::Preserve, vk::Format::R8G8B8A8_UNORM);
+        key.color_input = super::super::color_input::OrderedColorInputs::fixture(&[0]);
+        assert_eq!(key.color_final_layout(0), vk::ImageLayout::COLOR_ATTACHMENT_OPTIMAL, "requires COLOR_GENERAL=off");
+        key
+    }
+    #[test]
+    fn parent_review_readback_starts_and_restores_the_actual_pass_exit() {
+        let key = selected_key();
+        let (to, back) = primary_readback_barriers(key, vk::ImageLayout::TRANSFER_SRC_OPTIMAL,
+            vk::Image::null(), vk::AccessFlags::COLOR_ATTACHMENT_WRITE);
+        assert_eq!(to[0].old_layout, key.color_final_layout(0));
+        assert_eq!(back[0].new_layout, key.color_final_layout(0));
+        assert_eq!(to[0].new_layout, vk::ImageLayout::TRANSFER_SRC_OPTIMAL);
+        assert_eq!(back[0].old_layout, vk::ImageLayout::TRANSFER_SRC_OPTIMAL);
+    }
+    #[test]
+    fn parent_review_ready_primary_transitions_when_next_pass_layout_differs() {
+        let key = selected_key();
+        assert!(!pass_exit_needs_no_barrier(
+            super::super::pools::ResidentAccess::ColorWrite(key.color_final_layout(0)), key.color_layout(0)));
+    }
+    #[test]
+    fn parent_review_empty_restart_uses_final_to_entry_transition() {
+        let key = selected_key();
+        let barrier = primary_pass_restart_barrier(key, vk::Image::null());
+        assert_eq!(barrier[0].old_layout, key.color_final_layout(0));
