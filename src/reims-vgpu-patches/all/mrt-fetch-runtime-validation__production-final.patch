+/// A reflected framebuffer-fetch ordinal, bounded by the decoded pass shape.
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd, Hash)]
+pub struct ColorInputIndex(u8);
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct ColorInputIndexError(pub u32);
+impl ColorInputIndex {
+    pub fn parse(raw: u32) -> Result<Self, ColorInputIndexError> {
+        if raw < COLOR_ATTACHMENTS as u32 {
+            Ok(Self(raw as u8))
+        } else {
+            Err(ColorInputIndexError(raw))
+        }
+    }
+    pub const fn get(self) -> usize {
+        self.0 as usize
+    }
+}
+/// The semantic input slots. Holes retain their guest ordinal; no packed renumbering.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq, Ord, PartialOrd, Hash)]
+pub struct ColorInputs(u8);
+const _: () = assert!(COLOR_ATTACHMENTS == u8::BITS as usize);
+impl ColorInputs {
+    pub fn parse(indices: impl IntoIterator<Item = u32>) -> Result<Self, ColorInputIndexError> {
+        let mut result = Self::default();
+        for raw in indices {
+            let index = ColorInputIndex::parse(raw)?;
+            result.0 |= 1 << index.0;
+        }
+        Ok(result)
+    }
+    pub const fn is_empty(self) -> bool {
+        self.0 == 0
+    }
+    pub const fn contains(self, index: usize) -> bool {
+        index < COLOR_ATTACHMENTS && self.0 & (1u8 << index) != 0
+    }
+    pub const fn count(self) -> u32 {
+        self.0.count_ones()
+    }
+    pub fn span(self) -> usize {
+        (u8::BITS - self.0.leading_zeros()) as usize
+    }
+    pub fn iter(self) -> impl Iterator<Item = ColorInputIndex> {
+        (0..COLOR_ATTACHMENTS)
+            .filter(move |&i| self.contains(i))
+            .map(|i| ColorInputIndex(i as u8))
+    }
+}
