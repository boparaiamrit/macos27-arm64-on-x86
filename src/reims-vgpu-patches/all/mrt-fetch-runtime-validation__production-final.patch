+#[cfg(test)]
+mod mrt_order_indexed_cache_tests {
+    use super::super::color_input::OrderedColorInputs;
+    use super::*;
+    #[test]
+    fn mrt_order_selected_secondary_preserves_sparse_input_table_and_layout() {
+        for slots in [vec![], vec![0], vec![1], vec![0, 1], vec![7], vec![1, 7]] {
+            let mut key = PassKey::single(Color0Load::Clear, vk::Format::R8G8B8A8_UNORM);
+            key.secondary_count = 7;
+            key.color_input = OrderedColorInputs::fixture(&slots);
+            let refs = key.color_input_references();
+            assert_eq!(refs.len(), slots.last().map_or(0, |i| *i as usize + 1));
+            for (i, r) in refs.iter().enumerate() {
+                if slots.contains(&(i as u32)) {
+                    assert_eq!(r.attachment, i as u32);
+                    assert_eq!(r.layout, vk::ImageLayout::GENERAL);
+                    assert_eq!(key.color_layout(i), r.layout);
+                } else {
+                    assert_eq!(r.attachment, vk::ATTACHMENT_UNUSED);
+                }
+            }
+            let mut none = key;
+            none.color_input = Default::default();
+            for i in 0..8 {
+                if !slots.contains(&(i as u32)) {
+                    assert_eq!(key.color_layout(i), none.color_layout(i));
+                }
+            }
+        }
+    }
+    #[test]
+    fn mrt_order_cache_and_compatibility_distinguish_inputs() {
+        let mut a = PassKey::single(Color0Load::Clear, vk::Format::R8G8B8A8_UNORM);
+        a.secondary_count = 1;
+        a.color_input = OrderedColorInputs::fixture(&[0]);
+        let mut b = a;
+        b.color_input = OrderedColorInputs::fixture(&[1]);
+        assert_ne!(a, b);
+        assert_ne!(a.compatibility(), b.compatibility());
+        assert_ne!(a.framebuffer_compatibility(), b.framebuffer_compatibility());
+        assert_eq!(
+            a.compatibility().first_difference(b.compatibility()),
+            Some(PassCompatField::ColorInput)
+        );
+    }
+}
