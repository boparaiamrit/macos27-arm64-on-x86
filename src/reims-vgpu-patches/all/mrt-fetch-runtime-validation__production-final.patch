+#[cfg(test)]
+mod mrt_order_indexed_descriptor_tests {
+    use super::*;
+    use ash::vk::Handle;
+    use reims_vgpu_core::pass::ColorInputs;
+    #[test]
+    fn mrt_order_selected_secondary_uses_binding_193_and_exact_selected_view() {
+        for slots in [vec![], vec![0], vec![1], vec![0, 1], vec![7], vec![1, 7]] {
+            let inputs: Vec<_> = ColorInputs::parse(slots.clone())
+                .unwrap()
+                .iter()
+                .map(|i| {
+                    (
+                        i,
+                        vk::ImageView::from_raw(100 + i.get() as u64),
+                        vk::ImageLayout::GENERAL,
+                    )
+                })
+                .collect();
+            let mut out = Vec::new();
+            fill_descriptor_bindings(&mut out, &[], &[], &[], &inputs);
+            assert_eq!(out.len(), slots.len());
+            for (b, slot) in out.iter().zip(slots) {
+                match b {
+                    super::super::pools::PushDescriptorBinding::Image {
+                        binding,
+                        view,
+                        layout,
+                        ty,
+                        ..
+                    } => {
+                        assert_eq!(*binding, 192 + slot);
+                        assert_eq!(view.as_raw(), 100 + slot as u64);
+                        assert_eq!(*layout, vk::ImageLayout::GENERAL);
+                        assert_eq!(*ty, vk::DescriptorType::INPUT_ATTACHMENT);
+                    }
+                    _ => panic!("wrong descriptor kind"),
+                }
+            }
+        }
+    }
+}
