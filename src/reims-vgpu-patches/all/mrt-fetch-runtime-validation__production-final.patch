+        for indices in [vec![], vec![0], vec![1], vec![0, 1], vec![7], vec![1, 7]] {
+            let set = ColorInputs::parse(indices.clone()).unwrap();
+            assert_eq!(
+                set.iter().map(|i| i.get() as u32).collect::<Vec<_>>(),
+                indices
