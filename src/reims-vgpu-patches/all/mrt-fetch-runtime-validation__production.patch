@@ -0,0 +1,97 @@
+//! Admitted ordered framebuffer inputs. No feature widening or attachment inference.
+use ash::vk;
+use super::types::DrawError;
+use super::reason::DrawReason;
+use crate::backend::vulkan::caps::device_features::DeviceFeatures;
+pub use reims_vgpu_core::pass::{ColorInputs, ColorInputIndex, ColorInputIndexError, COLOR_ATTACHMENTS};
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum ColorInputDecline {
+    InvalidIndex(ColorInputIndexError),
+    OrderedAccessUnavailable,
+    PhysicalCapacity { requested: usize, limit: u32 },
+    DescriptorCapacity { requested: u32, limit: u32 },
+    MissingAttachment { index: usize },
+}
+impl crate::observe::Decline for ColorInputDecline {
+    fn slug(&self) -> &'static str {
+        match self {
+            Self::InvalidIndex(_) => "color_input_index_out_of_range",
+            Self::OrderedAccessUnavailable => "color_input_ordered_access_unavailable",
+            Self::PhysicalCapacity {..} => "color_input_attachment_capacity",
+            Self::DescriptorCapacity {..} => "color_input_descriptor_capacity",
+            Self::MissingAttachment {..} => "color_input_attachment_missing",
+        }
+    }
+    fn fields(&self) -> Vec<(&'static str,String)> {
+        match self {
+            Self::InvalidIndex(e)=>vec![("index",e.0.to_string())],
+            Self::OrderedAccessUnavailable=>vec![],
+            Self::PhysicalCapacity{requested,limit}=>vec![("requested",requested.to_string()),("limit",limit.to_string())],
+            Self::DescriptorCapacity{requested,limit}=>vec![("requested",requested.to_string()),("limit",limit.to_string())],
+            Self::MissingAttachment{index}=>vec![("index",index.to_string())],
+        }
+    }
+}
+pub(super) fn refusal(r: ColorInputDecline) -> DrawError { DrawError::Unsupported(DrawReason::ColorInput(r)) }
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq, Ord, PartialOrd, Hash)]
+pub(crate) struct OrderedColorInputs(ColorInputs);
+impl OrderedColorInputs {
+    pub(crate) fn admit(inputs: ColorInputs, caps: &DeviceFeatures, materialized: usize) -> Result<Self,DrawError> {
+        if inputs.is_empty() { return Ok(Self::default()); }
+        if !caps.ordered_color_attachment_access { return Err(refusal(ColorInputDecline::OrderedAccessUnavailable)); }
+        if materialized > COLOR_ATTACHMENTS || materialized > caps.max_color_attachments as usize {
+            return Err(refusal(ColorInputDecline::PhysicalCapacity{requested:materialized,limit:caps.max_color_attachments}));
+        }
+        if inputs.count() > caps.input_attachment_descriptor_limit {
+            return Err(refusal(ColorInputDecline::DescriptorCapacity{requested:inputs.count(),limit:caps.input_attachment_descriptor_limit}));
+        }
+        for index in inputs.iter() {
+            if index.get() >= materialized { return Err(refusal(ColorInputDecline::MissingAttachment{index:index.get()})); }
+        }
+        Ok(Self(inputs))
+    }
+    pub(crate) fn is_empty(self) -> bool { self.0.is_empty() }
+    pub(crate) fn contains(self,index:usize) -> bool { self.0.contains(index) }
+    pub(crate) fn iter(self) -> impl Iterator<Item=ColorInputIndex> { self.0.iter() }
+    pub(crate) fn span(self) -> usize { self.0.span() }
+    pub(crate) fn subpass_flags(self) -> vk::SubpassDescriptionFlags {
+        if self.is_empty() { vk::SubpassDescriptionFlags::empty() }
+        else { vk::SubpassDescriptionFlags::RASTERIZATION_ORDER_ATTACHMENT_COLOR_ACCESS_EXT }
+    }
+    pub(crate) fn blend_flags(self) -> vk::PipelineColorBlendStateCreateFlags {
+        if self.is_empty() { vk::PipelineColorBlendStateCreateFlags::empty() }
+        else { vk::PipelineColorBlendStateCreateFlags::RASTERIZATION_ORDER_ATTACHMENT_ACCESS_EXT }
+    }
+    #[cfg(test)]
+    pub(crate) fn fixture(indices: &[u32]) -> Self {
+        Self::admit(ColorInputs::parse(indices.iter().copied()).unwrap(), &DeviceFeatures {
+            ordered_color_attachment_access:true,max_color_attachments:8,input_attachment_descriptor_limit:8,..Default::default()
+        },COLOR_ATTACHMENTS).unwrap()
+    }
+}
+#[cfg(test)]
+mod mrt_order_plan_tests {
+    use super::*;
+    #[test]
+    fn mrt_order_gates_every_nonempty_input_and_preserves_empty_hosts() {
+        let off=DeviceFeatures::default();
+        assert!(OrderedColorInputs::admit(ColorInputs::default(),&off,100).is_ok());
+        for i in [0,1,7] {
+            assert_eq!(OrderedColorInputs::admit(ColorInputs::parse([i]).unwrap(),&off,8), Err(refusal(ColorInputDecline::OrderedAccessUnavailable)));
+        }
+        let on=DeviceFeatures{ordered_color_attachment_access:true,max_color_attachments:8,input_attachment_descriptor_limit:1,..Default::default()};
+        assert!(OrderedColorInputs::admit(ColorInputs::parse([7]).unwrap(),&on,8).is_ok());
+        assert!(matches!(OrderedColorInputs::admit(ColorInputs::parse([1]).unwrap(),&on,1),Err(DrawError::Unsupported(DrawReason::ColorInput(ColorInputDecline::MissingAttachment{index:1})))));
+        assert!(OrderedColorInputs::admit(ColorInputs::parse([0,1]).unwrap(),&on,2).is_err());
+        let low=DeviceFeatures{max_color_attachments:1,..on};
+        assert!(OrderedColorInputs::admit(ColorInputs::parse([1]).unwrap(),&low,2).is_err());
+    }
+    #[test]
+    fn mrt_order_flags_are_only_on_admitted_nonempty_plans() {
+        for indices in [vec![],vec![0],vec![1],vec![0,1],vec![7]] {
+            let p=OrderedColorInputs::fixture(&indices);
+            assert_eq!(p.subpass_flags().is_empty(),indices.is_empty());
+            assert_eq!(p.blend_flags().is_empty(),indices.is_empty());
+        }
+    }
+}
