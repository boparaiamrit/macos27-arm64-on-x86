+#[cfg(test)]
+mod mrt_order_baseline_layout {
+    use super::*;
+    #[test]
+    fn mrt_order_baseline_selected_secondary_requires_general_layout() {
+        let mut key = PassKey::single(Color0Load::Clear, vk::Format::R8G8B8A8_UNORM);
+        key.secondary_count = 1;
+        key.color_input = true;
+        assert_eq!(key.color_layout(1), vk::ImageLayout::GENERAL,
+            "selected input attachment 1 must use its own input-compatible layout");
+    }
