+#[cfg(test)]
+mod mrt_order_baseline_descriptor {
+    use super::*;
+    #[test]
+    fn mrt_order_baseline_selected_secondary_requires_binding_193() {
+        let mut out = Vec::new();
+        fill_descriptor_bindings(&mut out, &[], &[], &[],
+            Some((vk::ImageView::null(), vk::ImageLayout::GENERAL)));
+        let indices: Vec<_> = out.iter().filter_map(|b| match b {
+            super::super::pools::PushDescriptorBinding::Image {binding,ty,..}
+                if *ty == vk::DescriptorType::INPUT_ATTACHMENT => Some(*binding),
+            _ => None,
+        }).collect();
+        assert_eq!(indices, vec![super::super::types::COLOR_INPUT_BINDING + 1],
+            "fetch of secondary attachment 1 must bind 192+1, never attachment 0");
+    }
+}
