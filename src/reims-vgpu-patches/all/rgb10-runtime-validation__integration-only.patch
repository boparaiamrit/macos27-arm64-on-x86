+// Qualification-only injection at the capability door. Non-test builds always
+// query the real engine; no memory, debt, source-read or settle API is replaced.
+fn buffer_texture_sampled_layout_supported(layout: TexelLayout) -> bool {
+    #[cfg(test)]
+    if let Some(answer) = TEST_BUFFER_TEXTURE_CAPABILITY.with(|value| value.get()) {
+        return answer;
+    }
+    crate::backend::vulkan::engine::supports_sampled_layout_bind(layout)
+}
