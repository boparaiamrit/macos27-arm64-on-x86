+#[cfg(test)]
+struct TestBufferTextureCapability(Option<bool>);
+
+#[cfg(test)]
+impl TestBufferTextureCapability {
+    fn set(answer: bool) -> Self {
+        Self(TEST_BUFFER_TEXTURE_CAPABILITY.with(|value| value.replace(Some(answer))))
+    }
+}
