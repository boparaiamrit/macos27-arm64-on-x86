+            .returned
+            .take()
+            .expect("an asynchronous submit carries the owner's half of its handoff");
+        finish_submit(&FailureLatch::default(), Ok(()), reply, Some(returned));
+
+        assert_eq!(handoff.has_returned(), Ok(true));
+        assert_eq!(handoff.wait_returned(0), Ok(()));
