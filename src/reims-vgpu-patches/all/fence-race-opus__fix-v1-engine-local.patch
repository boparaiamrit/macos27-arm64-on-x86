+    /// The fence of an asynchronous submit is not the caller's while the
+    /// submission sits in the FIFO, and comes back only through the owner.
+    ///
+    /// This is the window the R8 `held-open-off` case fell into: the readback
+    /// that joined the batch waited the batch fence while this owner was still
+    /// inside `vkQueueSubmit` with it, and the Khronos threading layer reported
+    /// the two-thread use on every run.
+    #[test]
+    fn an_async_fence_is_lent_to_the_owner_until_its_submit_returns() {
+        let (sender, receiver) = mpsc::channel();
+        let owner = owner_with_sender(sender);
+
+        let handoff = owner
+            .submit_async(&[vk::CommandBuffer::from_raw(1)], vk::Fence::from_raw(2), None)
+            .expect("owner accepted submission");
+        assert_eq!(
+            handoff.has_returned(),
+            Ok(false),
+            "a fence still in the owner's FIFO may not be waited, queried or reset"
+        );
+        assert_eq!(handoff.wait_returned(1_000_000), Err(vk::Result::TIMEOUT));
+
+        let Request::Submit { mut submit, reply } =
+            receiver.try_recv().expect("submission remains in host FIFO")
+        else {
+            panic!("async handoff queued a non-submit request");
+        };
