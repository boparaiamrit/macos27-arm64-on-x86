+/// Publish one submission's outcome in the order its waiters depend on: latch
+/// an asynchronous failure or answer the synchronous caller, and only then give
+/// the fence back. A thread that sees the fence returned therefore also sees
+/// whether the call failed, which is when the fence will never signal.
+fn finish_submit(
+    failure: &FailureLatch,
+    result: Result<(), vk::Result>,
+    reply: Option<Reply>,
+    returned: Option<ReturnSignal>,
+) {
+    match reply {
+        None => {
+            if let Err(result) = result {
+                failure.set(result);
+            }
+        }
+        Some(reply) => {
+            let _ = reply.send(result.map(|_| QueueOutcome::Unit));
+        }
+    }
+    if let Some(returned) = returned {
+        returned.returned();
+    }
