+
+/// Where one asynchronous submission's `vkQueueSubmit` stands on the host.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum HostCall {
+    /// Waiting in this owner's FIFO, or inside the driver call.
+    Outstanding,
+    /// Back from the call, successful or not, with any failure it returned
+    /// already latched.
+    Returned,
+    /// Dropped without reaching the driver: the owner is gone, so the fence
+    /// will never be submitted.
+    Abandoned,
+}
+
+impl HostCall {
+    fn result(self) -> Result<(), vk::Result> {
+        match self {
+            Self::Outstanding => Err(vk::Result::TIMEOUT),
+            Self::Returned => Ok(()),
+            Self::Abandoned => Err(vk::Result::ERROR_DEVICE_LOST),
+        }
+    }
+}
+
+#[derive(Debug)]
+struct ReturnLatch {
+    state: Mutex<HostCall>,
+    changed: Condvar,
+}
+
+impl ReturnLatch {
+    /// Leave `Outstanding` exactly once; a later settle is a no-op.
+    fn settle(&self, to: HostCall) {
+        let mut state = self.state.lock().unwrap_or_else(|e| e.into_inner());
+        if *state == HostCall::Outstanding {
+            *state = to;
+            self.changed.notify_all();
+        }
+    }
+}
+
+/// The owner thread's half of a [`SubmitHandoff`].
+///
+/// Dropping it unsettled — the request never sent, or discarded with a dead
+/// owner thread — abandons the submission, so the fence's owner learns that
+/// immediately instead of waiting out a deadline for a call that will never
+/// happen.
+#[derive(Debug)]
+struct ReturnSignal(Arc<ReturnLatch>);
+
+impl ReturnSignal {
+    fn returned(self) {
+        self.0.settle(HostCall::Returned);
+    }
+}
+
+impl Drop for ReturnSignal {
+    fn drop(&mut self) {
+        self.0.settle(HostCall::Abandoned);
+    }
+}
+
+/// Whether the `vkQueueSubmit` that took one fence has returned on the host.
+///
+/// Until it has, the fence belongs to that call: the caller may not wait on,
+/// query, reset or destroy it. Completion is still the fence's own answer;
+/// this says only when the fence may be asked.
+#[derive(Debug)]
+pub(crate) struct SubmitHandoff(Option<Arc<ReturnLatch>>);
+
+impl SubmitHandoff {
+    /// A submission whose `vkQueueSubmit` already returned on the calling
+    /// thread: the synchronous rails, and a slot that has retired.
+    pub(crate) const RETURNED: Self = Self(None);
+
+    fn outstanding() -> (Self, ReturnSignal) {
+        let latch = Arc::new(ReturnLatch {
+            state: Mutex::new(HostCall::Outstanding),
+            changed: Condvar::new(),
+        });
+        (Self(Some(Arc::clone(&latch))), ReturnSignal(latch))
+    }
+
+    /// Whether the fence may be touched now. Never blocks; a submission the
+    /// owner abandoned answers `ERROR_DEVICE_LOST`.
+    pub(crate) fn has_returned(&self) -> Result<bool, vk::Result> {
+        let Some(latch) = self.0.as_ref() else {
+            return Ok(true);
+        };
+        match *latch.state.lock().unwrap_or_else(|e| e.into_inner()) {
+            HostCall::Outstanding => Ok(false),
+            settled => settled.result().map(|()| true),
+        }
+    }
+
+    /// Wait until the call has returned. `TIMEOUT` means the owner is still
+    /// inside it (or still behind earlier work) at the deadline; the caller
+    /// reports that the way it reports a fence that outlived the same deadline.
+    pub(crate) fn wait_returned(&self, timeout_ns: u64) -> Result<(), vk::Result> {
+        let Some(latch) = self.0.as_ref() else {
+            return Ok(());
+        };
+        let state = latch.state.lock().unwrap_or_else(|e| e.into_inner());
+        let (state, _) = latch
+            .changed
+            .wait_timeout_while(state, std::time::Duration::from_nanos(timeout_ns), |state| {
+                *state == HostCall::Outstanding
+            })
+            .unwrap_or_else(|e| e.into_inner());
+        state.result()
+    }
+}
+
+/// Two handoffs are equal when they are the same submission's.
+impl PartialEq for SubmitHandoff {
+    fn eq(&self, other: &Self) -> bool {
+        match (&self.0, &other.0) {
+            (None, None) => true,
+            (Some(a), Some(b)) => Arc::ptr_eq(a, b),
+            _ => false,
+        }
+    }
+}
