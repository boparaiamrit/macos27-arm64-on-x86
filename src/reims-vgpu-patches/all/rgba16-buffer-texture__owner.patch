+#[test]
+fn rgba16_buffer_texture_checks_eight_byte_geometry_and_source_overflows() {
+    let mut bt = rgba16_descriptor();
+    let plan = rgba16_admitted(&bt);
+    let exact = bt.offset + plan.span();
+    assert_eq!(
+        plan.read_window(0x8000, bt.offset - 1),
+        Err(BufferTextureRefusal::SourceRange)
+    );
+    assert_eq!(
+        plan.read_window(u64::MAX - bt.offset, exact),
+        Err(BufferTextureRefusal::GuestAddressOverflow)
+    );
+    bt.offset = u64::MAX;
+    assert_eq!(
+        rgba16_admitted(&bt).read_window(0, u64::MAX),
+        Err(BufferTextureRefusal::OffsetOverflow)
+    );
+    bt.offset = 0;
+    bt.bytes_per_row = 3071;
+    assert_eq!(
+        NativeBufferTexture::resolve(&bt, |_| true),
+        Err(BufferTextureRefusal::RowPitchShort)
+    );
+    bt.bytes_per_row = u64::MAX;
+    assert_eq!(
+        NativeBufferTexture::resolve(&bt, |_| true),
+        Err(BufferTextureRefusal::RowSpanOverflow)
+    );
+    bt.bytes_per_row = 1 << 63;
+    bt.desc.height = 2;
+    assert_eq!(
+        NativeBufferTexture::resolve(&bt, |_| true),
+        Err(BufferTextureRefusal::HostLengthOverflow)
+    );
+    bt.bytes_per_row = 0;
+    bt.desc.width = u32::MAX;
+    assert_eq!(
+        NativeBufferTexture::resolve(&bt, |_| true),
+        Err(BufferTextureRefusal::TightRowOverflow)
+    );
+    bt.desc.width = 384;
+    bt.desc.height = 0;
+    assert_eq!(
+        NativeBufferTexture::resolve(&bt, |_| true),
+        Err(BufferTextureRefusal::ZeroGeometry)
+    );
+}
+
+#[test]
+fn rgba16_buffer_texture_tight_default_upload_owns_all_eight_bytes() {
+    let mut bt = rgba16_descriptor();
+    bt.desc.width = 1;
+    bt.desc.height = 1;
+    bt.bytes_per_row = 0;
+    let plan = rgba16_admitted(&bt);
+    let mut source = vec![1, 0, 255, 1, 0, 128, 254, 255];
+    let (upload, format) = plan.copy_rows(&source).unwrap();
+    source.fill(0);
+    drop(source);
+    assert_eq!(plan.span(), 8);
+    assert_eq!(upload, [1, 0, 255, 1, 0, 128, 254, 255]);
+    assert_eq!(
+        format,
+        SampledByteFormat::from_source(
+            TexelLayout::Rgba16Unorm,
+            pixel_format::MTL_FORMAT_RGBA16_UNORM
+        )
+    );
+}
