+#[test]
+fn native_buffer_texture_selector_admits_exactly_the_two_native_formats() {
+    for format in 0..=u16::MAX {
+        let mut bt = descriptor();
+        bt.desc.pixel_format = format;
+        bt.bytes_per_row = 0;
+        let mut queried = None;
+        let plan = NativeBufferTexture::resolve(&bt, |layout| {
+            queried = Some(layout);
+            true
+        })
+        .unwrap();
+        match format {
+            pixel_format::MTL_FORMAT_RGB10A2_UNORM => {
+                assert!(plan.is_some());
+                assert_eq!(queried, Some(TexelLayout::Rgb10a2Unorm));
+            }
+            pixel_format::MTL_FORMAT_RGBA16_UNORM => {
+                assert!(plan.is_some());
+                assert_eq!(queried, Some(TexelLayout::Rgba16Unorm));
+            }
+            _ => {
+                assert!(
+                    plan.is_none(),
+                    "format {format:#x} must retain its old loader"
+                );
+                assert_eq!(queried, None);
+            }
+        }
+    }
+}
