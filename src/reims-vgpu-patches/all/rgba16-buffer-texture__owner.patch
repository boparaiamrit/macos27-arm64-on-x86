+fn rgba16_descriptor() -> BufferTextureDescriptor {
+    let mut bt = descriptor();
+    bt.desc.pixel_format = pixel_format::MTL_FORMAT_RGBA16_UNORM;
+    bt.desc.width = 384;
+    bt.desc.height = 384;
+    bt.bytes_per_row = 3072;
+    bt
+}
+
+fn rgba16_admitted(bt: &BufferTextureDescriptor) -> NativeBufferTexture {
+    NativeBufferTexture::resolve(bt, |layout| {
+        assert_eq!(layout, TexelLayout::Rgba16Unorm);
+        true
+    })
+    .unwrap()
+    .expect("RGBA16Unorm must select its native eight-byte upload plan")
+}
+
+#[test]
+fn rgba16_buffer_texture_preserves_adjacent_codes_in_all_channels_at_384_square() {
+    let bt = rgba16_descriptor();
+    let plan = rgba16_admitted(&bt);
+    let codes: [[u16; 4]; 2] = [[1, 511, 32767, 65534], [2, 512, 32768, 65535]];
+    let mut source = Vec::with_capacity(384 * 384 * 8);
+    for i in 0..384 * 384 {
+        for code in codes[i % 2] {
+            source.extend_from_slice(&code.to_le_bytes());
+        }
+    }
+    let (upload, format) = plan.copy_rows(&source).unwrap();
+    assert_eq!(plan.extent(), (384, 384));
+    assert_eq!(plan.span(), 384 * 3072);
+    assert_eq!(upload.len(), 384 * 384 * 8);
+    assert_eq!(
+        upload, source,
+        "all sixteen bits of all four channels survive"
+    );
+    assert_eq!(
+        format,
+        SampledByteFormat::from_source(TexelLayout::Rgba16Unorm, bt.desc.pixel_format)
+    );
+    for c in 0..4 {
+        let first = u16::from_le_bytes(upload[c * 2..c * 2 + 2].try_into().unwrap());
+        let second = u16::from_le_bytes(upload[8 + c * 2..10 + c * 2].try_into().unwrap());
+        assert_eq!(first, codes[0][c]);
+        assert_eq!(
+            second,
+            first + 1,
+            "adjacent channel {c} codes must stay ordered"
+        );
+    }
+}
