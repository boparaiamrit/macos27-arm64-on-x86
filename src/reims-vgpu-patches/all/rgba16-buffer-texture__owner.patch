+#[test]
+fn rgba16_buffer_texture_host_and_shape_refusals_do_not_fall_back_to_rgba8() {
+    let bt = rgba16_descriptor();
+    assert_eq!(
+        NativeBufferTexture::resolve(&bt, |_| false),
+        Err(BufferTextureRefusal::HostSampledLayout)
+    );
+    for which in 0..6 {
+        let mut invalid = bt;
+        match which {
+            0 => invalid.desc.texture_type = 3,
+            1 => invalid.desc.depth = 2,
+            2 => invalid.desc.array_length = 2,
+            3 => invalid.desc.sample_count = 4,
+            4 => invalid.desc.mipmap_level_count = 5,
+            5 => invalid.desc.swizzle = Some([2, 1, 0, 3]),
+            _ => unreachable!(),
+        }
+        assert_eq!(
+            NativeBufferTexture::resolve(&invalid, |_| panic!(
+                "shape must refuse before querying host"
+            )),
+            Err(BufferTextureRefusal::UnsupportedShape)
+        );
+    }
+}
