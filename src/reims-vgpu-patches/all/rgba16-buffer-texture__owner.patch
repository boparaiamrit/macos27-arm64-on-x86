+#[test]
+fn rgba16_buffer_texture_strips_odd_row_padding_at_a_nonzero_buffer_offset() {
+    let mut bt = rgba16_descriptor();
+    bt.desc.width = 3;
+    bt.desc.height = 3;
+    bt.bytes_per_row = 32;
+    bt.offset = 29;
+    let plan = rgba16_admitted(&bt);
+    assert_eq!(plan.span(), 2 * 32 + 24);
+    let allocation = bt.offset as usize + plan.span() as usize;
+    assert_eq!(
+        plan.read_window(0x8000, allocation as u64),
+        Ok((0x801d, 88))
+    );
+    let mut source = vec![0xa7u8; allocation];
+    let mut expected = Vec::new();
+    for y in 0..3 {
+        for x in 0..3 {
+            for c in 0..4 {
+                let code: u16 = (y * 1000 + x * 20 + c + 1) as u16;
+                let encoded = code.to_le_bytes();
+                let p = bt.offset as usize + y * 32 + x * 8 + c * 2;
+                source[p..p + 2].copy_from_slice(&encoded);
+                expected.extend_from_slice(&encoded);
+            }
+        }
+    }
+    let untouched = source.clone();
+    assert_eq!(
+        plan.copy_rows(&source[bt.offset as usize..]).unwrap().0,
+        expected
+    );
+    assert_eq!(source, untouched);
+    assert_eq!(
+        plan.copy_rows(&source[bt.offset as usize..allocation - 1]),
+        Err(BufferTextureRefusal::SourceBytesShort)
+    );
+    assert_eq!(
+        plan.read_window(0x8000, allocation as u64 - 1),
+        Err(BufferTextureRefusal::SourceRange)
+    );
+}
