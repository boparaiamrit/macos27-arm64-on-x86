+/// Test instrument: the Khronos validation layer's error reports, readable by
+/// the test that provoked them.
+///
+/// The layer prints its reports to stdout, and the qualification gate
+/// classifies those lines. A test that must *fail* on a report — a two-thread
+/// use of an externally synchronized fence, say — needs it in-process. While an
+/// application messenger is registered the layer stops printing on its own, so
+/// [`Listening`] prints every report it receives in the layer's format before
+/// recording it: the gate still sees each line, and the test can assert. It
+/// lives for one test; every other test runs with no messenger at all.
+#[cfg(test)]
+pub(crate) mod validation_capture {
+    use ash::vk;
+    use std::ffi::CStr;
+    use std::io::Write as _;
+    use std::sync::Mutex;
+
+    /// One error-severity report.
+    #[derive(Clone, Debug)]
+    pub(crate) struct Report {
+        pub(crate) id: String,
+        pub(crate) message: String,
+        pub(crate) objects: Vec<u64>,
+    }
+
+    static ERRORS: Mutex<Vec<Report>> = Mutex::new(Vec::new());
+
+    /// Every error a [`Listening`] heard in this process so far.
+    pub(crate) fn errors() -> Vec<Report> {
+        ERRORS.lock().unwrap_or_else(|e| e.into_inner()).clone()
+    }
+
+    /// Whether the loader offers `VK_EXT_debug_utils` to an instance.
+    pub(super) unsafe fn offered(entry: &ash::Entry) -> bool {
+        unsafe { entry.enumerate_instance_extension_properties(None) }.is_ok_and(|extensions| {
+            extensions.iter().any(|extension| {
+                let name = unsafe { CStr::from_ptr(extension.extension_name.as_ptr()) };
+                name == ash::ext::debug_utils::NAME
+            })
+        })
+    }
+
+    /// A messenger for the length of one test.
+    pub(crate) struct Listening {
+        loader: ash::ext::debug_utils::Instance,
+        messenger: vk::DebugUtilsMessengerEXT,
+    }
+
+    impl Listening {
+        /// `None` when the context's instance was created without
+        /// `VK_EXT_debug_utils`.
+        pub(crate) fn start(ctx: &super::DeviceContext) -> Option<Self> {
+            if !ctx.debug_utils {
+                return None;
+            }
+            let loader = ash::ext::debug_utils::Instance::new(&ctx._entry, &ctx.instance);
+            let info = vk::DebugUtilsMessengerCreateInfoEXT::default()
+                // The severity the layer's own stdout logging reports by default.
+                .message_severity(vk::DebugUtilsMessageSeverityFlagsEXT::ERROR)
+                .message_type(
+                    vk::DebugUtilsMessageTypeFlagsEXT::GENERAL
+                        | vk::DebugUtilsMessageTypeFlagsEXT::VALIDATION
+                        | vk::DebugUtilsMessageTypeFlagsEXT::PERFORMANCE,
+                )
+                .pfn_user_callback(Some(record));
+            let messenger = unsafe { loader.create_debug_utils_messenger(&info, None) }.ok()?;
+            Some(Self { loader, messenger })
+        }
+    }
+
+    impl Drop for Listening {
+        fn drop(&mut self) {
+            unsafe {
+                self.loader
+                    .destroy_debug_utils_messenger(self.messenger, None)
+            };
+        }
+    }
+
+    /// `VkFence` from `FENCE`: the name the layer prints for an object type.
+    fn type_name(object_type: vk::ObjectType) -> String {
+        let words = format!("{object_type:?}");
+        let mut name = String::from("Vk");
+        for word in words.split('_') {
+            let mut chars = word.chars();
+            if let Some(first) = chars.next() {
+                name.push(first);
+                name.push_str(&chars.as_str().to_lowercase());
+            }
+        }
+        name
+    }
+
+    unsafe extern "system" fn record(
+        severity: vk::DebugUtilsMessageSeverityFlagsEXT,
+        _types: vk::DebugUtilsMessageTypeFlagsEXT,
+        data: *const vk::DebugUtilsMessengerCallbackDataEXT<'_>,
+        _user: *mut std::ffi::c_void,
+    ) -> vk::Bool32 {
+        if !severity.contains(vk::DebugUtilsMessageSeverityFlagsEXT::ERROR) || data.is_null() {
+            return vk::FALSE;
+        }
+        // No panic may cross this boundary.
+        let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let data = unsafe { &*data };
+            let text = |p: *const std::ffi::c_char| {
+                if p.is_null() {
+                    String::new()
+                } else {
+                    unsafe { CStr::from_ptr(p) }.to_string_lossy().into_owned()
+                }
+            };
+            let objects: &[vk::DebugUtilsObjectNameInfoEXT<'_>] = if data.p_objects.is_null() {
+                &[]
+            } else {
+                unsafe { std::slice::from_raw_parts(data.p_objects, data.object_count as usize) }
+            };
+            let id = text(data.p_message_id_name);
+            let message = text(data.p_message);
+            // The layer's own line, which it does not print while this
+            // messenger is registered.
+            let mut line = format!(
+                "Validation Error: [ {id} ] | MessageID = {:#x}\n{message}\nObjects: {}\n",
+                data.message_id_number as u32,
+                objects.len()
+            );
+            for (index, object) in objects.iter().enumerate() {
+                line.push_str(&format!(
+                    "    [{index}] {} {:#x}\n",
+                    type_name(object.object_type),
+                    object.object_handle
+                ));
+            }
+            line.push('\n');
+            let mut out = std::io::stdout().lock();
+            let _ = out.write_all(line.as_bytes());
+            let _ = out.flush();
+            ERRORS
+                .lock()
+                .unwrap_or_else(|e| e.into_inner())
+                .push(Report {
+                    id,
+                    message,
+                    objects: objects.iter().map(|object| object.object_handle).collect(),
+                });
+        }));
+        vk::FALSE
+    }
+}
