     uint64_t offset;
@@ -2797,6 +2799,10 @@ static int hvf_handle_exception(CPUState *cpu, hv_vcpu_exit_exception_t *excp)
 
         trace_hvf_insn_abort(env->pc, set, fnv, ea, s1ptw, ifsc);
 
+        if (hvf_arm_exec_fault &&
+            hvf_arm_exec_fault(cpu, excp->physical_address)) {
+            break;
+        }
         /* fall through */
     }
     default:
