+//! Translate a local synthetic textual AIR fixture through the public production API.
+use metal2vulkan::passes::Stage;
+use std::{fs, path::PathBuf};
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let args: Vec<_> = std::env::args_os().skip(1).collect();
+    if args.len() != 3 {
+        return Err("expected stage input.ll output.spv".into());
+    }
+    let stage = match args[0].to_str() {
+        Some("vertex") => Stage::Vertex,
+        Some("fragment") => Stage::Fragment,
+        _ => return Err("expected vertex or fragment".into()),
+    };
+    let source = fs::read_to_string(&args[1])?;
+    let output = PathBuf::from(&args[2]);
+    let tmp = std::env::temp_dir().join(format!("m2v_stage_fixture_{}", std::process::id()));
+    fs::create_dir(&tmp)?;
+    let result = metal2vulkan::translate_sanitized_native(&source, stage, &tmp);
+    fs::remove_dir_all(&tmp)?;
+    let payload = result?;
+    fs::write(output, payload)?;
+    Ok(())
+}
