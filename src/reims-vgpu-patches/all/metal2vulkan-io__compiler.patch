+/// Floating scalar/vector component width and lane count, read from the retained types.
+/// Aggregates do not have a scalar/vector interface contract here.
+pub(in crate::passes) fn float_component_shape(ctx: &Ctx, ty: Word) -> Option<(u32, u32)> {
+    let definition = type_def_of(ctx, ty)?;
+    let (scalar, lanes) = if definition.class.opcode == Op::TypeVector {
+        match definition.operands.as_slice() {
+            [Operand::IdRef(scalar), Operand::LiteralBit32(lanes)] if (2..=4).contains(lanes) => {
+                (*scalar, *lanes)
+            }
+            _ => return None,
+        }
+    } else {
+        (ty, 1)
+    };
+    let scalar = type_def_of(ctx, scalar)?;
+    if scalar.class.opcode != Op::TypeFloat {
+        return None;
+    }
+    match scalar.operands.as_slice() {
+        [Operand::LiteralBit32(bits)] => Some((*bits, lanes)),
+        _ => None,
+    }
+}
+
+/// Core Vulkan stage transport for AIR half scalar/vector values.
+///
+/// `shaderFloat16` permits half arithmetic but does not imply `storageInputOutput16`.
+/// Use float32 at the stage boundary, retaining the AIR value type in the body and
+/// numerically converting on each boundary load/store. This leaves buffer layouts,
+/// arithmetic precision, locations and interpolation qualifiers unchanged.
+pub(in crate::passes) fn portable_stage_float_type(
+    ctx: &mut Ctx,
+    ty: Word,
+) -> Result<Word, String> {
+    match float_component_shape(ctx, ty) {
+        Some((16, 1)) => return Ok(ctx.ty_float()),
+        Some((16, lanes)) => return Ok(ctx.ty_vecf(lanes)),
+        _ => {}
+    }
+    if stage_type_contains_half(ctx, ty, &mut HashMap::new(), &mut HashSet::new(), 0)? {
+        return Err(format!(
+            "half aggregate stage interface type {ty} is unsupported: only scalar/vector \
+             half stage transport has a defined numerical conversion"
+        ));
+    }
+    Ok(ty)
+}
+
+fn stage_type_contains_half(
+    ctx: &Ctx,
+    ty: Word,
+    memo: &mut HashMap<Word, bool>,
+    active: &mut HashSet<Word>,
+    depth: usize,
+) -> Result<bool, String> {
+    if let Some(result) = memo.get(&ty) {
+        return Ok(*result);
+    }
+    if depth > 64 || !active.insert(ty) {
+        return Err(format!(
+            "unresolved recursive/deep stage interface type {ty}"
+        ));
+    }
+    let definition =
+        type_def_of(ctx, ty).ok_or_else(|| format!("unresolved stage interface type {ty}"))?;
+    let result = match definition.class.opcode {
+        Op::TypeFloat => match definition.operands.as_slice() {
+            [Operand::LiteralBit32(bits)] => *bits == 16,
+            _ => return Err(format!("unresolved floating stage interface type {ty}")),
+        },
+        Op::TypeInt | Op::TypeBool => false,
+        Op::TypeVector | Op::TypeMatrix | Op::TypeArray | Op::TypeRuntimeArray => {
+            let Some(Operand::IdRef(element)) = definition.operands.first() else {
+                return Err(format!("unresolved aggregate stage interface type {ty}"));
+            };
+            stage_type_contains_half(ctx, *element, memo, active, depth + 1)?
+        }
+        Op::TypeStruct => {
+            let mut contains = false;
+            for member in &definition.operands {
+                let Operand::IdRef(member) = member else {
+                    return Err(format!("unresolved struct stage interface type {ty}"));
+                };
+                contains |= stage_type_contains_half(ctx, *member, memo, active, depth + 1)?;
+            }
+            contains
+        }
+        _ => return Err(format!("unsupported stage interface type {ty}")),
+    };
+    active.remove(&ty);
+    memo.insert(ty, result);
+    Ok(result)
 }
 
