+//! Half precision belongs to the AIR program, while portable Vulkan stage transport is float32.
+
+use metal2vulkan::passes::Stage;
+use metal2vulkan::{disassemble, translate_sanitized_native};
+use std::collections::HashMap;
+
+const VERTEX: &str = r#"target triple = "air64_v28-apple-macosx26.5.0"
+define <{ <4 x float>, <4 x half> }> @vert(<4 x float> %pos, <4 x half> %varying) {
+entry:
+  %h = fadd <4 x half> %varying, <half 0xH0000, half 0xH0000, half 0xH0000, half 0xH0000>
+  %r0 = insertvalue <{ <4 x float>, <4 x half> }> undef, <4 x float> %pos, 0
+  %r1 = insertvalue <{ <4 x float>, <4 x half> }> %r0, <4 x half> %h, 1
+  ret <{ <4 x float>, <4 x half> }> %r1
+}
+!air.vertex = !{!0}
+!0 = !{ptr @vert, !1, !4}
+!1 = !{!2, !3}
+!2 = !{!"air.position", !"air.invariant", !"air.arg_type_name", !"float4", !"air.arg_name", !"position"}
+!3 = !{!"air.vertex_output", !"generated(varying)", !"air.arg_type_name", !"half4", !"air.arg_name", !"varying"}
+!4 = !{!5, !6}
+!5 = !{i32 0, !"air.vertex_input", !"air.location_index", i32 0, !"air.arg_type_name", !"float4", !"air.arg_name", !"pos"}
+!6 = !{i32 1, !"air.vertex_input", !"air.location_index", i32 1, !"air.arg_type_name", !"half4", !"air.arg_name", !"varying"}
+"#;
+
+const FRAGMENT: &str = r#"target triple = "air64_v28-apple-macosx26.5.0"
+define <4 x half> @frag(<4 x half> %varying) {
+entry:
+  %h = fadd <4 x half> %varying, <half 0xH0000, half 0xH0000, half 0xH0000, half 0xH0000>
+  ret <4 x half> %h
+}
+!air.fragment = !{!0}
+!0 = !{ptr @frag, !1, !3}
+!1 = !{!2}
+!2 = !{!"air.render_target", i32 0, i32 0, !"air.arg_type_name", !"half4"}
+!3 = !{!4}
+!4 = !{i32 0, !"air.fragment_input", !"generated(varying)", !"air.center", !"air.no_perspective", !"air.arg_type_name", !"half4", !"air.arg_name", !"varying"}
+"#;
+
+fn translate(source: &str, stage: Stage, name: &str) -> String {
+    let tmp =
+        std::env::temp_dir().join(format!("m2v_half_stage_io_{}_{}", std::process::id(), name));
+    std::fs::create_dir_all(&tmp).expect("create scratch");
+    let words =
+        translate_sanitized_native(source, stage, &tmp).expect("translate through native owner");
+    let asm = disassemble(&words).expect("disassemble validated product module");
+    std::fs::remove_dir_all(tmp).expect("remove scratch");
+    asm
+}
+
+fn assert_float32_interfaces(asm: &str, minimum: usize) {
+    let definitions: HashMap<&str, Vec<&str>> = asm
+        .lines()
+        .filter_map(|line| {
+            let (id, value) = line.trim().split_once(" = ")?;
+            Some((id, value.split_whitespace().collect()))
+        })
+        .collect();
+    let mut interfaces = 0;
+    for def in definitions.values() {
+        if def.first() != Some(&"OpVariable")
+            || !matches!(def.get(2).copied(), Some("Input" | "Output"))
+        {
+            continue;
+        }
+        interfaces += 1;
+        let ptr = &definitions[def[1]];
+        assert_eq!(ptr[0], "OpTypePointer");
+        let mut scalar = &definitions[ptr[2]];
+        if scalar[0] == "OpTypeVector" {
+            scalar = &definitions[scalar[1]];
+        }
+        assert_eq!(
+            scalar.as_slice(),
+            ["OpTypeFloat", "32"],
+            "stage variable retains unsupported half transport:\n{asm}"
+        );
+    }
+    assert!(
+        interfaces >= minimum,
+        "fixture did not retain expected interfaces"
+    );
+    assert!(
+        asm.contains("OpTypeFloat 16"),
+        "half program type was erased"
+    );
+    assert!(
+        definitions.values().any(|def| {
+            def.first() == Some(&"OpFAdd") && floating_width(&definitions, def[1]) == Some(16)
+        }),
+        "half arithmetic was erased: {asm}"
+    );
+    assert!(!asm.contains("StorageInputOutput16"));
+}
+
+fn floating_width(definitions: &HashMap<&str, Vec<&str>>, ty: &str) -> Option<u32> {
+    let mut definition = definitions.get(ty)?;
+    if definition.first() == Some(&"OpTypeVector") {
+        definition = definitions.get(definition.get(1)?)?;
+    }
+    if definition.first() != Some(&"OpTypeFloat") {
+        return None;
+    }
+    definition.get(1)?.parse().ok()
+}
+
+#[test]
+fn vertex_half_input_and_output_use_numeric_boundary_conversions() {
+    let asm = translate(VERTEX, Stage::Vertex, "vertex");
+    assert_float32_interfaces(&asm, 4);
+    assert!(
+        asm.lines()
+            .filter(|line| line.contains("OpFConvert"))
+            .count()
+            >= 2
+    );
+    assert!(asm.contains("BuiltIn Position"));
+    assert!(asm.contains("Invariant"));
+}
