+#[test]
+fn half_array_varying_is_an_explicit_fallback() {
+    let source = r#"target triple = "air64_v28-apple-macosx26.5.0"
+define <4 x half> @frag([2 x half] %varying) {
+entry:
+  %h = extractvalue [2 x half] %varying, 0
+  %r0 = insertelement <4 x half> zeroinitializer, half %h, i32 0
+  ret <4 x half> %r0
+}
+!air.fragment = !{!0}
+!0 = !{ptr @frag, !1, !3}
+!1 = !{!2}
+!2 = !{!"air.render_target", i32 0, i32 0, !"air.arg_type_name", !"half4"}
+!3 = !{!4}
+!4 = !{i32 0, !"air.fragment_input", !"generated(varying)", !"air.center", !"air.no_perspective", !"air.arg_type_name", !"half2", !"air.arg_name", !"varying"}
+"#;
+    let tmp = std::env::temp_dir().join(format!("m2v_half_array_{}", std::process::id()));
+    std::fs::create_dir(&tmp).expect("scratch");
+    let error =
+        translate_sanitized_native(source, Stage::Fragment, &tmp).expect_err("half array fallback");
+    std::fs::remove_dir_all(tmp).expect("remove scratch");
+    assert!(
+        error.contains("half aggregate stage interface"),
+        "wrong refusal: {error}"
+    );
+}
