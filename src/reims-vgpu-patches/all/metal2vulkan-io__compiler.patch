+#[test]
+fn fragment_half_input_and_output_keep_half_arithmetic_and_interpolation() {
+    let asm = translate(FRAGMENT, Stage::Fragment, "fragment");
+    assert_float32_interfaces(&asm, 2);
+    assert!(
+        asm.lines()
+            .filter(|line| line.contains("OpFConvert"))
+            .count()
+            >= 2
+    );
