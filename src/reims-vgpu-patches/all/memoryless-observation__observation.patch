+//! Evidence at the memoryless colour-target refusal, never a resource route.
+//!
+//! Tag 9 is the memoryless serializer blob published by createMemorylessTexture,
+//! not a mapper-ref texture (tag 11). No backing, pages, layout or allocation is
+//! inferred here. In particular, a blob's length cannot select its descriptor
+//! layout. The existing wire framer reports opcode/length only when the header
+//! frames a record; that does not validate a descriptor body or select its layout.
+//!
+//! This process-lifetime diagnostic budget keeps eight distinct observations,
+//! without eviction or reset in production. The eighth emits a cap marker and
+//! all later calls skip descriptor reads. It owns no guest resource or lifetime.
+//! Identity is the current task/list-entry snapshot, not a minted incarnation;
+//! reuse with identical identity, bytes and attachment settings is indistinguishable.
+
+use crate::model::DeviceState;
+use crate::runtime::decode::resource::ListObjectEntry;
+use crate::runtime::host::HostMemory;
+use crate::runtime::objects;
+use crate::runtime::render_pass::ColorAttachment;
+use parking_lot::Mutex;
+use std::fmt::{self, Write};
+
+pub(super) const OBJECT_TYPE_MEMORYLESS_TEXTURE: u8 = 9;
+const MAX_DESCRIPTOR_BYTES: usize = 256;
+const MAX_SHAPES: usize = 8;
+const MAX_LINE_BYTES: usize = 2048;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Descriptor {
+    Complete([u8; MAX_DESCRIPTOR_BYTES]),
+    Oversize,
+    Unreadable,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+struct AttachmentShape {
+    texture_ref: u32,
+    resolve_texture_ref: u32,
+    level: u32,
+    slice: u32,
+    depth_plane: u32,
+    load_action: u16,
+    store_action: u16,
+    // Bit identity also distinguishes signed zero and preserves NaN payloads.
+    clear_color_bits: [u64; 4],
+}
+
+impl From<ColorAttachment> for AttachmentShape {
+    fn from(a: ColorAttachment) -> Self {
+        Self {
+            texture_ref: a.texture_ref,
+            resolve_texture_ref: a.resolve_texture_ref,
+            level: a.level,
+            slice: a.slice,
+            depth_plane: a.depth_plane,
+            load_action: a.load_action,
+            store_action: a.store_action,
+            clear_color_bits: a.clear_color.map(f64::to_bits),
+        }
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+struct Shape {
+    device: u64,
+    task: u32,
+    base_ref: u32,
+    page_shift: u32,
+    // Directory PFN, object-list PFN, count: a current-list identity, not a generation.
+    task_list: Option<(u32, u32, u32)>,
+    entry: ListObjectEntry,
+    attachment: AttachmentShape,
+    descriptor: Descriptor,
+}
+
+struct Budget {
+    shapes: [Option<Shape>; MAX_SHAPES],
+    len: usize,
+}
+
+impl Budget {
+    const fn new() -> Self {
+        Self {
+            shapes: [None; MAX_SHAPES],
+            len: 0,
+        }
+    }
+}
+
+static BUDGET: Mutex<Budget> = Mutex::new(Budget::new());
+
+// Formatting cannot grow a String past a planned bound after reading guest data.
+struct Line {
+    bytes: [u8; MAX_LINE_BYTES],
+    len: usize,
+}
+
+impl Write for Line {
+    fn write_str(&mut self, s: &str) -> fmt::Result {
+        let end = self.len.checked_add(s.len()).ok_or(fmt::Error)?;
+        self.bytes
+            .get_mut(self.len..end)
+            .ok_or(fmt::Error)?
+            .copy_from_slice(s.as_bytes());
+        self.len = end;
+        Ok(())
+    }
+}
+
+/// Called only with the live entry that is about to receive WrongType.
+/// Both bounds are checked before read_descriptor can allocate/read guest bytes.
+pub(super) fn note<M: HostMemory>(
+    state: &DeviceState,
+    host: &M,
+    task_id: u32,
+    base_ref: u32,
+    entry: &ListObjectEntry,
+    att: ColorAttachment,
+) {
+    let mut budget = BUDGET.lock();
+    if budget.len == MAX_SHAPES {
+        return;
+    }
+    let descriptor = if entry.descriptor_length as usize > MAX_DESCRIPTOR_BYTES {
+        Descriptor::Oversize
+    } else {
+        match objects::read_descriptor(state, host, task_id, entry) {
+            Some(bytes) if bytes.len() == entry.descriptor_length as usize => {
+                let mut raw = [0; MAX_DESCRIPTOR_BYTES];
+                raw[..bytes.len()].copy_from_slice(&bytes);
+                Descriptor::Complete(raw)
+            }
+            _ => Descriptor::Unreadable,
+        }
+    };
+    let shape = Shape {
+        device: state.id.0,
+        task: task_id,
+        base_ref,
+        page_shift: state.page_shift,
+        task_list: state
+            .tasks
+            .get(task_id)
+            .map(|t| (t.directory_pfn, t.object_list_pfn, t.object_list_count)),
+        entry: *entry,
+        attachment: att.into(),
+        descriptor,
+    };
+    if budget.shapes[..budget.len].contains(&Some(shape)) {
+        return;
+    }
+    let index = budget.len;
+    budget.shapes[index] = Some(shape);
+    budget.len += 1;
+    let mut line = Line {
+        bytes: [0; MAX_LINE_BYTES],
+        len: 0,
+    };
+    if write_observation(&mut line, &shape, att, budget.len).is_ok() {
+        // Every write_str copied complete UTF-8 strings.
+        crate::observe::fail(
+            std::str::from_utf8(&line.bytes[..line.len]).unwrap_or(
+                "rt_memoryless_observation reason=diagnostic_format_failed complete=false",
+            ),
+        );
+    } else {
+        crate::observe::fail(
+            "rt_memoryless_observation reason=diagnostic_format_failed complete=false",
+        );
+    }
+    if budget.len == MAX_SHAPES {
+        crate::observe::fail(
+            "rt_memoryless_observation reason=cap_reached cap=8 lifetime=process \
+             further_observations=disabled descriptor_reads=disabled",
+        );
+    }
+}
+
+fn write_observation(
+    line: &mut Line,
+    s: &Shape,
+    att: ColorAttachment,
+    ordinal: usize,
+) -> fmt::Result {
+    let (reason, complete) = match s.descriptor {
+        Descriptor::Complete(_) => ("complete", true),
+        Descriptor::Oversize => ("descriptor_oversize", false),
+        Descriptor::Unreadable => ("descriptor_unreadable", false),
+    };
+    write!(
+        line,
+        "rt_memoryless_observation reason={reason} complete={complete} \
+         observation={ordinal} device={} task={} base={} object_type={} \
+         identity=current_list_entry task_list={:?} page_shift={} \
+         descriptor_gva={:#x} descriptor_len={} descriptor_limit={} \
+         texture_ref={} resolve_texture_ref={} level={} slice={} depth_plane={} \
+         load_action={} store_action={} clear_color={:?} clear_color_bits={:016x?}",
+        s.device,
+        s.task,
+        s.base_ref,
+        s.entry.object_type,
+        s.task_list,
+        s.page_shift,
+        s.entry.descriptor_gva,
+        s.entry.descriptor_length,
+        MAX_DESCRIPTOR_BYTES,
+        att.texture_ref,
+        att.resolve_texture_ref,
+        att.level,
+        att.slice,
+        att.depth_plane,
+        att.load_action,
+        att.store_action,
+        att.clear_color,
+        s.attachment.clear_color_bits,
+    )?;
+    if let Descriptor::Complete(raw) = &s.descriptor {
+        let bytes = &raw[..s.entry.descriptor_length as usize];
+        match reims_vgpu_wire::op::op(bytes, 0) {
+            Ok(op) => write!(
+                line,
+                " header_view=framed_only opcode={:#x} declared_len={}",
+                op.opcode(),
+                op.length(),
+            )?,
+            Err(_) => write!(line, " header_view=unavailable")?,
+        }
+        write!(line, " raw_hex=")?;
+        for byte in bytes {
+            write!(line, "{byte:02x}")?;
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::model::{DeviceId, PAGE_SHIFT_ARM64E};
+    use crate::protocol::endian::st32;
+    use crate::runtime::decode::resource::{list_object_entry_offset, OBJECT_LIST_ENTRY_LEN};
+    use crate::runtime::gva_mem::{define_task_pages_arm64e, write_task_gva_arm64e};
+    use crate::runtime::host::{FakeHost, HostAction, HostMemory, HostOps, MemError};
+    use std::cell::RefCell;
+
+    const DESCRIPTOR_GVA: u64 = 0x5000;
+    const DESCRIPTOR_GPA: u64 = (5 << PAGE_SHIFT_ARM64E) + 0x1000;
+    const TEXTURE_REF: u32 = 11;
+
+    struct RecordingHost {
+        inner: FakeHost,
+        reads: RefCell<Vec<(u64, usize)>>,
+        writes: usize,
+    }
+
+    impl HostMemory for RecordingHost {
+        fn read_gpa(&self, gpa: u64, buf: &mut [u8]) -> Result<(), MemError> {
+            self.reads.borrow_mut().push((gpa, buf.len()));
+            self.inner.read_gpa(gpa, buf)
+        }
+
+        fn write_gpa(&mut self, gpa: u64, buf: &[u8]) -> Result<(), MemError> {
+            self.writes += 1;
+            self.inner.write_gpa(gpa, buf)
+        }
+    }
+
+    impl HostOps for RecordingHost {
+        fn mono_ns(&self) -> u64 {
+            self.inner.mono_ns()
+        }
+        fn enqueue(&mut self, action: HostAction) {
+            self.inner.enqueue(action);
+        }
+        fn schedule_bh(&mut self) {
+            self.inner.schedule_bh();
+        }
+        fn is_ram_gpa(&self, gpa: u64) -> bool {
+            self.inner.is_ram_gpa(gpa)
+        }
+    }
+
+    struct Fixture {
+        state: DeviceState,
+        host: RecordingHost,
+        att: ColorAttachment,
+    }
+
+    impl Fixture {
+        // FailCapture and this diagnostic budget follow the study's serial-test rule.
+        fn new(blob: &[u8], declared: u32, object_type: u8) -> Self {
+            *BUDGET.lock() = Budget::new();
+            let mut state = DeviceState::new(DeviceId(7), PAGE_SHIFT_ARM64E);
+            let mut inner = FakeHost::new();
+            define_task_pages_arm64e(&mut inner, &mut state, 4, 2);
+            assert!(state.set_object_list(1, 0, 256));
+            write_task_gva_arm64e(&mut inner, &state.tasks[1], DESCRIPTOR_GVA, blob);
+            let off = list_object_entry_offset(TEXTURE_REF, 256).unwrap();
+            let mut entry = [0; OBJECT_LIST_ENTRY_LEN];
+            st32(&mut entry, u32::from(object_type) | (declared << 8));
+            entry[4..12].copy_from_slice(&DESCRIPTOR_GVA.to_le_bytes());
+            write_task_gva_arm64e(&mut inner, &state.tasks[1], off, &entry);
+            Self {
+                state,
+                host: RecordingHost {
+                    inner,
+                    reads: RefCell::new(Vec::new()),
+                    writes: 0,
+                },
+                att: ColorAttachment {
+                    texture_ref: TEXTURE_REF,
+                    resolve_texture_ref: 10,
+                    level: 2,
+                    slice: 3,
+                    depth_plane: 4,
+                    load_action: 2,
+                    store_action: 3,
+                    clear_color: [0.25, -0.0, 0.75, 1.0],
+                },
+            }
+        }
+
+        fn refuse(&mut self, expected_type: u8) {
+            let e = super::super::resolve_render_target(&mut self.state, &self.host, 1, self.att)
+                .expect_err("observation must not accept a target");
+            assert_eq!(e.base_ref, TEXTURE_REF);
+            assert!(matches!(
+                e.cause,
+                super::super::RenderTargetCause::WrongType { object_type }
+                if object_type == expected_type
+            ));
+            assert_eq!(self.host.writes, 0);
+            assert!(self.host.inner.actions.is_empty());
+            assert_eq!(self.host.inner.map_pages_calls, 0);
+            assert_eq!(self.state.mappings.len(), 0);
+        }
+
+        fn descriptor_reads(&self) -> usize {
+            self.host
+                .reads
+                .borrow()
+                .iter()
+                .filter(|(gpa, _)| *gpa == DESCRIPTOR_GPA)
+                .count()
+        }
+    }
+
+    // Synthetic arbitrary bytes test evidence capture, not a recovered guest layout.
+    fn blob() -> Vec<u8> {
+        let mut raw: Vec<u8> = (0..44).collect();
+        raw[..4].copy_from_slice(&1u32.to_le_bytes());
+        raw[4..8].copy_from_slice(&44u32.to_le_bytes());
+        raw
+    }
+
+    fn observations(cap: &crate::observe::FailCapture) -> Vec<String> {
+        cap.lines()
+            .into_iter()
+            .filter(|l| l.starts_with("rt_memoryless_observation "))
+            .collect()
+    }
+
+    fn recorded_bytes(line: &str) -> Vec<u8> {
+        let hex = line
+            .split_whitespace()
+            .find_map(|s| s.strip_prefix("raw_hex="))
+            .expect("a complete observation carries all raw bytes");
+        (0..hex.len())
+            .step_by(2)
+            .map(|i| u8::from_str_radix(&hex[i..i + 2], 16).unwrap())
+            .collect()
+    }
+
+    #[test]
+    fn complete_blob_and_attachment_are_observed_before_the_original_refusal() {
+        let raw = blob();
+        let mut f = Fixture::new(&raw, raw.len() as u32, 9);
+        let cap = crate::observe::FailCapture::start();
+        f.refuse(9);
+        assert!(super::super::lookup_render_target(&mut f.state, &f.host, 1, f.att).is_none());
+        let lines = cap.lines();
+        assert_eq!(observations(&cap).len(), 1);
+        assert_eq!(recorded_bytes(&lines[0]), raw);
+        assert!(lines[0].contains("complete=true"));
+        for field in [
+            "device=7",
+            "task=1",
+            "base=11",
+            "object_type=9",
+            "task_list=Some((2, 0, 256))",
+            "descriptor_gva=0x5000",
+            "descriptor_len=44",
+            "texture_ref=11",
+            "resolve_texture_ref=10",
+            "level=2",
+            "slice=3",
+            "depth_plane=4",
+            "load_action=2",
+            "store_action=3",
+            "clear_color=[0.25, -0.0, 0.75, 1.0]",
+            "8000000000000000",
+            "header_view=framed_only opcode=0x1 declared_len=44",
+        ] {
+            assert!(lines[0].contains(field), "missing {field}: {}", lines[0]);
+        }
+        let original = cap.one("rt_resolve");
+        assert!(original.contains("reason=rt_wrong_type base=11 object_type=9 task=1 ref=11"));
+        assert!(lines.iter().position(|l| l == &original).unwrap() > 0);
+        assert_eq!(f.host.writes, 0);
+    }
+
+    #[test]
+    fn repeated_shape_is_deduplicated_but_changed_bytes_and_settings_are_not() {
+        let raw = blob();
+        let mut f = Fixture::new(&raw, 44, 9);
+        let cap = crate::observe::FailCapture::start();
+        for _ in 0..4 {
+            f.refuse(9);
+        }
+        assert_eq!(observations(&cap).len(), 1);
+        let mut changed = raw.clone();
+        changed[43] ^= 1; // Same opcode/length, different unknown descriptor byte.
+        write_task_gva_arm64e(
+            &mut f.host.inner,
+            &f.state.tasks[1],
+            DESCRIPTOR_GVA,
+            &changed,
+        );
+        f.refuse(9);
+        f.att.store_action += 1;
+        f.refuse(9);
+        f.att.clear_color[1] = 0.0; // Preserve the bit-level difference from -0.0.
+        f.refuse(9);
+        let lines = observations(&cap);
+        assert_eq!(lines.len(), 4);
+        assert_eq!(recorded_bytes(&lines[1]), changed);
+        assert!(lines[2].contains("store_action=4"));
+    }
+
+    #[test]
+    fn eight_shapes_emit_one_cap_marker_and_stop_descriptor_reads_without_eviction() {
+        let mut f = Fixture::new(&blob(), 44, 9);
+        let cap = crate::observe::FailCapture::start();
+        for n in 0..MAX_SHAPES {
+            f.att.slice = n as u32;
+            f.refuse(9);
+        }
+        let reads = f.descriptor_reads();
+        for n in 0..24 {
+            f.att.slice = n;
+            f.refuse(9);
+        }
+        let lines = observations(&cap);
+        assert_eq!(
+            lines
+                .iter()
+                .filter(|l| l.contains("reason=complete "))
+                .count(),
+            MAX_SHAPES
+        );
+        assert_eq!(
+            lines
+                .iter()
+                .filter(|l| l.contains("reason=cap_reached "))
+                .count(),
+            1
+        );
+        assert_eq!(f.descriptor_reads(), reads);
+        assert_eq!(BUDGET.lock().len, MAX_SHAPES);
+        assert!(lines.iter().all(|l| l.len() <= MAX_LINE_BYTES + 64));
+    }
+
+    #[test]
+    fn oversize_blob_is_not_read_and_does_not_change_wrong_type() {
+        let mut f = Fixture::new(&[], 0xff_ffff, 9);
+        let cap = crate::observe::FailCapture::start();
+        f.refuse(9);
+        f.refuse(9);
+        assert_eq!(f.descriptor_reads(), 0);
+        let lines = observations(&cap);
+        assert_eq!(lines.len(), 1);
+        assert!(lines[0].contains("reason=descriptor_oversize complete=false"));
+        assert!(lines[0].contains("descriptor_len=16777215 descriptor_limit=256"));
+        assert!(!lines[0].contains("raw_hex="));
+        assert!(f.host.reads.borrow().iter().all(|(_, len)| *len <= 256));
+    }
+
+    #[test]
+    fn unreadable_blob_respects_host_memory_refusal() {
+        let mut f = Fixture::new(&blob(), 44, 9);
+        f.host.inner.mark_non_ram(DESCRIPTOR_GPA, 44);
+        let cap = crate::observe::FailCapture::start();
+        f.refuse(9);
+        let lines = observations(&cap);
+        assert_eq!(lines.len(), 1);
+        assert!(lines[0].contains("reason=descriptor_unreadable complete=false"));
+        assert!(!lines[0].contains("raw_hex="));
+        assert_eq!(f.descriptor_reads(), 1);
+    }
+
+    #[test]
+    fn a_changed_current_list_entry_is_not_hidden_by_identical_blob_bytes() {
+        let raw = blob();
+        let mut f = Fixture::new(&raw, 44, 9);
+        let cap = crate::observe::FailCapture::start();
+        f.refuse(9);
+        let replacement_gva = DESCRIPTOR_GVA + 0x100;
+        write_task_gva_arm64e(&mut f.host.inner, &f.state.tasks[1], replacement_gva, &raw);
+        let off = list_object_entry_offset(TEXTURE_REF, 256).unwrap();
+        write_task_gva_arm64e(
+            &mut f.host.inner,
+            &f.state.tasks[1],
+            off + 4,
+            &replacement_gva.to_le_bytes(),
+        );
+        f.refuse(9);
+        let lines = observations(&cap);
+        assert_eq!(lines.len(), 2);
+        assert_eq!(recorded_bytes(&lines[0]), recorded_bytes(&lines[1]));
+        assert!(lines[1].contains("descriptor_gva=0x5100"));
+    }
+
+    #[test]
+    fn a_short_blob_is_complete_without_inventing_a_wire_header() {
+        let mut f = Fixture::new(&[0x12, 0x34, 0x56], 3, 9);
+        let cap = crate::observe::FailCapture::start();
+        f.refuse(9);
+        let line = observations(&cap).remove(0);
+        assert!(line.contains("complete=true"));
+        assert!(line.contains("header_view=unavailable"));
+        assert_eq!(recorded_bytes(&line), vec![0x12, 0x34, 0x56]);
+    }
+
+    #[test]
+    fn descriptor_bound_is_inclusive_and_header_words_do_not_select_a_layout() {
+        let mut raw = vec![0xa5; MAX_DESCRIPTOR_BYTES];
+        raw[..4].copy_from_slice(&0xdead_beefu32.to_le_bytes());
+        raw[4..8].copy_from_slice(&9999u32.to_le_bytes());
+        let mut f = Fixture::new(&raw, MAX_DESCRIPTOR_BYTES as u32, 9);
+        f.att.clear_color = [f64::MAX, f64::MIN_POSITIVE, f64::NAN, f64::NEG_INFINITY];
+        let cap = crate::observe::FailCapture::start();
+        f.refuse(9);
+        let line = observations(&cap).remove(0);
+        assert_eq!(recorded_bytes(&line), raw);
+        assert!(line.contains("header_view=unavailable"));
+        assert!(!line.contains(" opcode="));
+        assert_eq!(f.descriptor_reads(), 1);
+        assert!(line.len() < MAX_LINE_BYTES);
+    }
+
+    #[test]
+    fn another_wrong_type_does_not_spend_the_memoryless_budget_or_read_its_blob() {
+        // Tag 8 is a texture view and already reads its descriptor upstream.
+        let mut f = Fixture::new(&blob(), 44, 0xfe);
+        let cap = crate::observe::FailCapture::start();
+        f.refuse(0xfe);
+        assert!(observations(&cap).is_empty());
+        assert_eq!(BUDGET.lock().len, 0);
+        assert_eq!(f.descriptor_reads(), 0);
+    }
+}
