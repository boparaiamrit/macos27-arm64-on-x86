+//! Native opcode-9 storage for the packed RGB10A2 format. Other formats keep
+//! their existing RGBA8 loader; ten-bit words never enter that converter.
+
+use crate::observe::Decline;
+use crate::protocol::pixel_format::{self, SampledByteFormat, TexelLayout};
+use crate::runtime::decode::resource::{BufferTextureDescriptor, TextureLevelLayout};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum BufferTextureRefusal {
+    UnsupportedShape,
+    ZeroGeometry,
+    TightRowOverflow,
+    RowPitchShort,
+    RowSpanOverflow,
+    HostLengthOverflow,
+    HostSampledLayout,
+    OffsetOverflow,
+    SourceRange,
+    GuestAddressOverflow,
+    SourceBytesShort,
+}
+
+impl Decline for BufferTextureRefusal {
+    fn slug(&self) -> &'static str {
+        match self {
+            Self::UnsupportedShape => "buftex_native_shape",
+            Self::ZeroGeometry => "buftex_native_zero_geometry",
+            Self::TightRowOverflow => "buftex_native_tight_row_overflow",
+            Self::RowPitchShort => "buftex_native_row_pitch_short",
+            Self::RowSpanOverflow => "buftex_native_row_span_overflow",
+            Self::HostLengthOverflow => "buftex_native_host_length_overflow",
+            Self::HostSampledLayout => "buftex_native_host_sampled_layout",
+            Self::OffsetOverflow => "buftex_native_offset_overflow",
+            Self::SourceRange => "buftex_native_source_range",
+            Self::GuestAddressOverflow => "buftex_native_guest_address_overflow",
+            Self::SourceBytesShort => "buftex_native_source_bytes_short",
+        }
+    }
+}
+
+/// A native upload whose source geometry and host sampled-format capability
+/// have both been established. Guest storage is still read by the runtime's
+/// existing debt-paying, settling buffer reader, never by this value.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct NativeBufferTexture {
+    level: TextureLevelLayout,
+}
+
+impl NativeBufferTexture {
+    /// `None` means this format stays on its existing loader. Once RGB10A2 has
+    /// selected this owner, an unsupported shape or host is a refusal, never
+    /// permission to quantize the words or reinterpret them as RGBA8.
+    pub(super) fn resolve(
+        bt: &BufferTextureDescriptor,
+        supports_sampled_layout: impl FnOnce(TexelLayout) -> bool,
+    ) -> Result<Option<Self>, BufferTextureRefusal> {
+        use BufferTextureRefusal as R;
+        if bt.desc.pixel_format != pixel_format::MTL_FORMAT_RGB10A2_UNORM {
+            return Ok(None);
+        }
+        let d = &bt.desc;
+        // SampledSourceRequest's byte source carries one 2D image. Do not
+        // invent missing planes, mips, multisamples, or a descriptor swizzle.
+        if d.texture_type != 2
+            || d.depth != 1
+            || d.array_length != 1
+            || d.sample_count != 1
+            || d.mipmap_level_count != 1
+            || d.swizzle.is_some()
+        {
+            return Err(R::UnsupportedShape);
+        }
+        if d.width == 0 || d.height == 0 {
+            return Err(R::ZeroGeometry);
+        }
+        let tight = TexelLayout::Rgb10a2Unorm
+            .tight_row_bytes(d.width)
+            .ok_or(R::TightRowOverflow)?;
+        let pitch = if bt.bytes_per_row == 0 {
+            u64::from(tight)
+        } else {
+            bt.bytes_per_row
+        };
+        if pitch < u64::from(tight) {
+            return Err(R::RowPitchShort);
+        }
+        let mut level = TextureLevelLayout {
+            offset: bt.offset,
+            row_stride: pitch,
+            width: d.width,
+            height: d.height,
+            depth: 1,
+            ..Default::default()
+        };
+        // The existing geometry owner excludes padding after the last row.
+        level.size = level.read_span(tight).ok_or(R::RowSpanOverflow)?;
+        super::host_alloc_len(level.size).ok_or(R::HostLengthOverflow)?;
+        super::host_alloc_len(u64::from(tight) * u64::from(d.height))
+            .ok_or(R::HostLengthOverflow)?;
+        if !supports_sampled_layout(TexelLayout::Rgb10a2Unorm) {
+            return Err(R::HostSampledLayout);
+        }
+        Ok(Some(Self { level }))
+    }
+
+    pub(super) fn extent(self) -> (u32, u32) {
+        (self.level.width, self.level.height)
+    }
+
+    pub(super) fn offset(self) -> u64 {
+        self.level.offset
+    }
+
+    pub(super) fn span(self) -> u64 {
+        self.level.size
+    }
+
+    /// Validate the texture's complete read against the buffer allocation and
+    /// the address space before the runtime allocates or reads any guest bytes.
+    pub(super) fn read_window(
+        self,
+        buffer_gva: u64,
+        buffer_size: u64,
+    ) -> Result<(u64, u64), BufferTextureRefusal> {
+        use BufferTextureRefusal as R;
+        let end = self
+            .offset()
+            .checked_add(self.span())
+            .ok_or(R::OffsetOverflow)?;
+        if end > buffer_size {
+            return Err(R::SourceRange);
+        }
+        buffer_gva.checked_add(end).ok_or(R::GuestAddressOverflow)?;
+        // The checked end includes a nonempty span, so the start cannot wrap.
+        Ok((buffer_gva + self.offset(), self.span()))
+    }
+
+    /// `raw` begins at the validated buffer offset. The result owns its bytes
+    /// independently of the guest allocation and excludes every padding byte.
+    pub(super) fn copy_rows(
+        self,
+        raw: &[u8],
+    ) -> Result<(Vec<u8>, SampledByteFormat), BufferTextureRefusal> {
+        use BufferTextureRefusal as R;
+        if (raw.len() as u64) < self.span() {
+            return Err(R::SourceBytesShort);
+        }
+        // Construction checked these widths and lengths and the value is
+        // private, so no unchecked external geometry can reach this gather.
+        let row = TexelLayout::Rgb10a2Unorm
+            .tight_row_bytes(self.level.width)
+            .unwrap() as usize;
+        let mut bytes = vec![0; row * self.level.height as usize];
+        for y in 0..self.level.height as usize {
+            let src = y * self.level.row_stride as usize;
+            bytes[y * row..(y + 1) * row].copy_from_slice(&raw[src..src + row]);
+        }
+        Ok((
+            bytes,
+            SampledByteFormat::from_source(
+                TexelLayout::Rgb10a2Unorm,
+                pixel_format::MTL_FORMAT_RGB10A2_UNORM,
+            ),
+        ))
+    }
+}
