+#[test]
+fn every_native_buffer_texture_refusal_has_a_distinct_slug() {
+    use crate::observe::Decline;
+    let refusals = [
+        BufferTextureRefusal::UnsupportedShape,
+        BufferTextureRefusal::ZeroGeometry,
+        BufferTextureRefusal::TightRowOverflow,
+        BufferTextureRefusal::RowPitchShort,
+        BufferTextureRefusal::RowSpanOverflow,
+        BufferTextureRefusal::HostLengthOverflow,
+        BufferTextureRefusal::HostSampledLayout,
+        BufferTextureRefusal::OffsetOverflow,
+        BufferTextureRefusal::SourceRange,
+        BufferTextureRefusal::GuestAddressOverflow,
+        BufferTextureRefusal::SourceBytesShort,
+    ];
+    let names: std::collections::HashSet<_> = refusals.iter().map(Decline::slug).collect();
+    assert_eq!(names.len(), refusals.len());
