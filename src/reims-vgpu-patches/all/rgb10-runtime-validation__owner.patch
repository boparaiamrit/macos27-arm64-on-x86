+/// Opcode-9 byte uploads select their storage layout before reading the
+/// buffer. RGB10A2 has no RGBA8 alternative; host refusal is terminal for that
+/// bind. Every other format retains the existing converting loader.
+fn load_buffer_texture_upload<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut M,
+    task_id: u32,
+    texture_ref: u32,
+    bt: &BufferTextureDescriptor,
+) -> Option<(u32, u32, Vec<u8>, SampledByteFormat)> {
+    use super::buffer_texture::NativeBufferTexture;
+
+    let refuse = |reason: super::buffer_texture::BufferTextureRefusal| {
+        crate::observe::fail(format!(
+            "buftex native_refused reason={} task={task_id} ref={texture_ref} descriptor={bt:?}",
+            reason.slug(),
+        ));
+    };
+    let plan = match NativeBufferTexture::resolve(
+        bt,
+        crate::backend::vulkan::engine::supports_sampled_layout_bind,
+    ) {
+        Ok(Some(plan)) => plan,
+        Ok(None) => {
+            let (w, h, rgba) = load_buffer_texture_rgba(state, host, task_id, texture_ref, bt)?;
+            return Some((
+                w,
+                h,
+                rgba,
+                SampledByteFormat::from_source(TexelLayout::Rgba8, bt.desc.pixel_format),
+            ));
+        }
+        Err(reason) => {
+            refuse(reason);
+            return None;
+        }
+    };
+    // Retain both debts of the existing loader: the bound texture reference
+    // here, and the backing buffer reference in read_buffer_bytes_resolved's
+    // census/pay/settle transaction. No guest allocation is evicted or rebound.
+    crate::runtime::writeback_debt::pay_for_texture(state, host, task_id, texture_ref);
+    let backing = resolve_buffer_backing(state, host, task_id, bt.buffer_ref, None)?;
+    if let Err(reason) = plan.read_window(backing.gva, backing.size) {
+        refuse(reason);
+        return None;
+    }
+    let raw = read_buffer_bytes_resolved(
+        state,
+        host,
+        task_id,
+        bt.buffer_ref,
+        &backing,
+        plan.offset(),
+        Some(plan.span()),
+    )?;
+    let (bytes, format) = match plan.copy_rows(&raw) {
+        Ok(upload) => upload,
+        Err(reason) => {
+            refuse(reason);
+            return None;
+        }
+    };
+    let (w, h) = plan.extent();
+    Some((w, h, bytes, format))
+}
