+use super::*;
+use crate::runtime::heap_query::TextureDescriptor;
+
+fn descriptor() -> BufferTextureDescriptor {
+    BufferTextureDescriptor {
+        new_texture_ref: 31,
+        buffer_ref: 32,
+        offset: 64,
+        bytes_per_row: 512,
+        desc: TextureDescriptor {
+            texture_type: 2,
+            framebuffer_only: false,
+            is_drawable: false,
+            allow_gpu_optimized_contents: false,
+            usage: 1,
+            pixel_format: pixel_format::MTL_FORMAT_RGB10A2_UNORM,
+            width: 106,
+            height: 106,
+            depth: 1,
+            mipmap_level_count: 1,
+            sample_count: 1,
+            array_length: 1,
+            resource_options: 0,
+            protection_options: 0,
+            swizzle: None,
+        },
+    }
+}
+
+fn admitted(bt: &BufferTextureDescriptor) -> NativeBufferTexture {
+    NativeBufferTexture::resolve(bt, |layout| {
+        assert_eq!(layout, TexelLayout::Rgb10a2Unorm);
+        true
+    })
+    .unwrap()
+    .expect("native ten-bit plan")
+}
+
+#[test]
+fn rgb10_buffer_texture_preserves_native_words_at_106_width_and_512_pitch() {
+    let bt = descriptor();
+    let plan = admitted(&bt);
+    let words: [u32; 3] = [
+        1 | (513 << 10) | (1022 << 20) | (3 << 30),
+        2 | (513 << 10) | (1022 << 20) | (3 << 30),
+        1023 | (1 << 10) | (512 << 20) | (1 << 30),
+    ];
+    // Red values 1 and 2 are distinct in ten bits and both round to zero in
+    // eight. An RGBA8 intermediate therefore cannot satisfy this oracle.
+    let mut raw = vec![0xacu8; 512 * 106];
+    for y in 0..106 {
+        for x in 0..106 {
+            raw[y * 512 + x * 4..y * 512 + x * 4 + 4]
+                .copy_from_slice(&words[(y + x) % 3].to_le_bytes());
+        }
+    }
+    let (bytes, format) = plan.copy_rows(&raw).unwrap();
+    assert_eq!(plan.extent(), (106, 106));
+    assert_eq!(
+        format,
+        SampledByteFormat::from_source(TexelLayout::Rgb10a2Unorm, bt.desc.pixel_format)
+    );
+    assert_eq!(bytes.len(), 106 * 106 * 4);
+    for y in 0..106 {
+        assert_eq!(&bytes[y * 424..(y + 1) * 424], &raw[y * 512..y * 512 + 424]);
+    }
+    assert_ne!(&bytes[0..4], &bytes[4..8]);
+}
+
+#[test]
+fn native_buffer_texture_needs_no_trailing_row_padding() {
+    let plan = admitted(&descriptor());
+    let exact = 105 * 512 + 424;
+    let raw = vec![0x5bu8; exact];
+    assert_eq!(plan.span(), exact as u64);
+    assert!(plan.copy_rows(&raw).is_ok());
+    assert_eq!(
+        plan.copy_rows(&raw[..exact - 1]),
+        Err(BufferTextureRefusal::SourceBytesShort)
+    );
+}
+
+#[test]
+fn native_buffer_texture_offset_is_bounded_by_the_source_allocation() {
+    let bt = descriptor();
+    let plan = admitted(&bt);
+    let exact = bt.offset + plan.span();
+    assert_eq!(plan.read_window(0x8000, exact), Ok((0x8040, plan.span())));
+    assert_eq!(
+        plan.read_window(0x8000, exact - 1),
+        Err(BufferTextureRefusal::SourceRange)
+    );
+    assert_eq!(
+        plan.read_window(0x8000, bt.offset - 1),
+        Err(BufferTextureRefusal::SourceRange)
+    );
+    assert_eq!(
+        plan.read_window(u64::MAX - bt.offset, exact),
+        Err(BufferTextureRefusal::GuestAddressOverflow)
+    );
+}
+
+#[test]
+fn native_buffer_texture_checks_offset_and_row_span_overflow() {
+    let mut bt = descriptor();
+    bt.offset = u64::MAX;
+    assert_eq!(
+        admitted(&bt).read_window(0, u64::MAX),
+        Err(BufferTextureRefusal::OffsetOverflow)
+    );
+    bt.offset = 0;
+    bt.bytes_per_row = u64::MAX;
+    assert_eq!(
+        NativeBufferTexture::resolve(&bt, |_| true),
+        Err(BufferTextureRefusal::RowSpanOverflow)
+    );
+    bt.bytes_per_row = 423;
+    assert_eq!(
+        NativeBufferTexture::resolve(&bt, |_| true),
+        Err(BufferTextureRefusal::RowPitchShort)
+    );
+    bt.bytes_per_row = 1 << 63;
+    bt.desc.height = 2;
+    assert_eq!(
+        NativeBufferTexture::resolve(&bt, |_| true),
+        Err(BufferTextureRefusal::HostLengthOverflow)
+    );
+    bt.bytes_per_row = 0;
+    bt.desc.width = u32::MAX;
+    assert_eq!(
+        NativeBufferTexture::resolve(&bt, |_| true),
+        Err(BufferTextureRefusal::TightRowOverflow)
+    );
+}
+
+#[test]
+fn native_buffer_texture_tight_default_keeps_the_word_bytes() {
+    let mut bt = descriptor();
+    bt.bytes_per_row = 0;
+    bt.desc.width = 2;
+    bt.desc.height = 1;
+    let plan = admitted(&bt);
+    let raw = [1, 4, 16, 64, 2, 8, 32, 128];
+    assert_eq!(plan.span(), 8);
+    assert_eq!(plan.copy_rows(&raw).unwrap().0, raw);
+}
+
+#[test]
+fn native_buffer_texture_refuses_an_unsupported_host_instead_of_converting() {
+    let bt = descriptor();
+    assert_eq!(
+        NativeBufferTexture::resolve(&bt, |_| false),
+        Err(BufferTextureRefusal::HostSampledLayout)
+    );
+}
+
+#[test]
+fn native_buffer_texture_leaves_every_other_format_on_its_existing_route() {
+    for format in [
+        0,
+        pixel_format::MTL_FORMAT_RGBA8_UNORM,
+        pixel_format::MTL_FORMAT_BGRA8_UNORM,
+        pixel_format::MTL_FORMAT_BGRA8_UNORM_SRGB,
+        pixel_format::MTL_FORMAT_BGR10A2_UNORM,
+        0xffff,
+    ] {
+        let mut bt = descriptor();
+        bt.desc.pixel_format = format;
+        assert_eq!(
+            NativeBufferTexture::resolve(&bt, |_| panic!("no host query for {format:#x}")),
+            Ok(None)
+        );
+    }
+}
+
+#[test]
+fn native_buffer_texture_refuses_shapes_the_2d_request_cannot_express() {
+    for select in 0..6 {
+        let mut bt = descriptor();
+        match select {
+            0 => bt.desc.texture_type = 3,
+            1 => bt.desc.depth = 2,
+            2 => bt.desc.array_length = 2,
+            3 => bt.desc.sample_count = 4,
+            4 => bt.desc.mipmap_level_count = 2,
+            5 => bt.desc.swizzle = Some([2, 1, 0, 3]),
+            _ => unreachable!(),
+        }
+        assert_eq!(
+            NativeBufferTexture::resolve(&bt, |_| panic!("shape refused before host query")),
+            Err(BufferTextureRefusal::UnsupportedShape)
+        );
+    }
+    let mut bt = descriptor();
+    bt.desc.width = 0;
+    assert_eq!(
+        NativeBufferTexture::resolve(&bt, |_| true),
+        Err(BufferTextureRefusal::ZeroGeometry)
+    );
+    bt.desc.width = 106;
+    bt.desc.height = 0;
+    assert_eq!(
+        NativeBufferTexture::resolve(&bt, |_| true),
+        Err(BufferTextureRefusal::ZeroGeometry)
+    );
+}
+
+#[test]
+fn native_buffer_texture_copy_owns_its_bytes_after_source_release() {
+    let mut bt = descriptor();
+    bt.bytes_per_row = 0;
+    bt.desc.width = 1;
+    bt.desc.height = 1;
+    let plan = admitted(&bt);
+    let mut raw = vec![1, 2, 3, 4];
+    let (upload, _) = plan.copy_rows(&raw).unwrap();
+    raw.fill(0);
+    drop(raw);
+    assert_eq!(upload, [1, 2, 3, 4]);
+}
