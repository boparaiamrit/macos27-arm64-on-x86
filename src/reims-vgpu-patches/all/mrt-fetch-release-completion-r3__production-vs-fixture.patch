+fn destroy_actual_engine(state:&crate::model::DeviceState){
+    super::device_caches(state).unwrap().with(|caches| {
+        let mut g=super::lock_engine();
+        let mut ctx=g.owner.ctx.take().expect("actual Vulkan device was created");
+        ctx.queue_wait_idle().expect("quiesce before owned destruction");
+        unsafe {caches.destroy_all(&ctx.device);g.pools.destroy_all(&ctx.device);eprintln!("R3_ACTUAL_DEVICE_DESTROY_BEGIN");ctx.destroy();eprintln!("R3_ACTUAL_DEVICE_DESTROY_COMPLETE");}
+        *caches=super::ObjectCaches::new();g.pools=super::ResourcePools::new();g.owner=super::ContextOwner::new();
