+// VkImageCreateInfo-pNext-01443 requires an external image to start UNDEFINED.
+// Transitioning from UNDEFINED does not preserve existing guest pixels. Until
+// this rail establishes those pixels through a defined initialization operation,
+// a caller requiring them must use the existing owned-image upload path. This is
+// an initialization-contract refusal, not a statement about hardware support.
+fn imported_initial_layout(preserve_host_contents: bool) -> Result<vk::ImageLayout, WindowRefusal> {
+    if preserve_host_contents {
+        Err(WindowRefusal::PreservedContentsUnsupported)
+    } else {
+        Ok(vk::ImageLayout::UNDEFINED)
+    }
+}
