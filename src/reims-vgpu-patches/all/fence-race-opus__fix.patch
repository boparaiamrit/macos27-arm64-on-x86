+            .map(|report| format!("{}: {}", report.id, report.message))
+            .collect()
+    }
+
+    /// The readback that joins an open batch hands it off and waits its fence
+    /// at once — `copy_image_level0_to_host_delivered`'s `batch_flush` then
+    /// `wait_entry_fence`. That wait may begin only once the owner is back.
+    #[test]
+    fn a_joined_readback_waits_its_batch_fence_only_after_the_owner_returns() {
+        crate::observe::redirect_logs_for_tests();
+        let mut ctx = match unsafe { DeviceContext::create() } {
+            Ok(c) => c,
+            Err(e) => {
+                eprintln!("SKIP ring fence handoff: no device ({e})");
+                return;
+            }
+        };
+        let listening = listen(&ctx);
+        let counters = EngineCounters::default();
+        let mut pools = ResourcePools::new();
+        unsafe { pools.ensure_init(&ctx, &counters) }.expect("ring");
+        let fence = unsafe { open_batch(&ctx, &mut pools, &counters) };
+
+        let hold = ctx.queue_owner.as_ref().expect("queue owner").hold();
+        unsafe { pools.batch_flush(&ctx, &counters) }.expect("handoff");
+        let release = release_later(hold);
+        unsafe { pools.wait_entry_fence(&ctx, &counters, fence) }
+            .expect("the batch completes once the owner submits it");
+        assert_eq!(
+            async_submits_returned(&ctx),
+            1,
+            "the batch fence was waited before the owner was back from vkQueueSubmit"
+        );
+        release.join().expect("release thread");
+        ctx.queue_wait_idle()
+            .expect("quiesce before owned destruction");
+        assert_eq!(
+            threading_reports_on(fence),
+            Vec::<String>::new(),
+            "the batch fence was used by two threads at once"
+        );
+
+        unsafe { pools.destroy_all(&ctx.device) };
+        drop(listening);
+        unsafe { ctx.destroy() };
+    }
+
+    /// The quiesce every completion stamp runs hands the open batch off and
+    /// then waits and resets every pending fence — the batch's included.
+    #[test]
+    fn retiring_a_handed_off_batch_waits_for_the_owner_to_return() {
+        crate::observe::redirect_logs_for_tests();
+        let mut ctx = match unsafe { DeviceContext::create() } {
+            Ok(c) => c,
+            Err(e) => {
+                eprintln!("SKIP ring fence handoff: no device ({e})");
+                return;
+            }
+        };
+        let listening = listen(&ctx);
+        let counters = EngineCounters::default();
+        let mut pools = ResourcePools::new();
+        unsafe { pools.ensure_init(&ctx, &counters) }.expect("ring");
+        let fence = unsafe { open_batch(&ctx, &mut pools, &counters) };
+
+        let hold = ctx.queue_owner.as_ref().expect("queue owner").hold();
+        let release = release_later(hold);
+        unsafe { pools.retire_all(&ctx, &counters) }
+            .expect("the ring retires once the owner submits the batch");
+        assert_eq!(
+            async_submits_returned(&ctx),
+            1,
+            "a slot fence was waited before the owner was back from vkQueueSubmit"
+        );
+        assert_eq!(pools.in_flight, 0, "the handed-off batch retired");
+        release.join().expect("release thread");
+        ctx.queue_wait_idle()
+            .expect("quiesce before owned destruction");
+        assert_eq!(
+            threading_reports_on(fence),
+            Vec::<String>::new(),
+            "the batch fence was used, or reset, by two threads at once"
+        );
+
+        unsafe { pools.destroy_all(&ctx.device) };
+        drop(listening);
+        unsafe { ctx.destroy() };
+    }
