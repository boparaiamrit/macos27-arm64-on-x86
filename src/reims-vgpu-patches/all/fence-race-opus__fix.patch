+#[cfg(test)]
+impl QueueOwner {
+    /// Park the owner behind everything sent so far, so a test can decide when
+    /// a later submission reaches the driver instead of leaving it to the
+    /// scheduler.
+    pub(crate) fn hold(&self) -> OwnerHold {
