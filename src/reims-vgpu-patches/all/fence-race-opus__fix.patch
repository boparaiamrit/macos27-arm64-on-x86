+/// Test seam returned by [`QueueOwner::hold`]: the owner thread stays parked
+/// where the hold entered its FIFO until this is dropped.
+#[cfg(test)]
+pub(crate) struct OwnerHold {
+    _release: mpsc::SyncSender<()>,
+}
