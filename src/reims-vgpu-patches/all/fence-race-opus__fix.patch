+//! A host object lent to another thread for the length of one host call, and
+//! the moment it comes back.
+//!
+//! # Handing work off is not handing it back
+//!
+//! A submission thread that accepts work and returns before making the host
+//! call has taken more than the work. For the length of that call it holds
+//! whatever the call declares externally synchronized — on the Vulkan rail, the
+//! fence `vkQueueSubmit` will signal — and the thread that handed the work off
+//! may not wait on, query, reset or destroy that object until the call has
+//! returned. Nothing about the handoff says when that is: the work can still be
+//! queued behind the borrower, or inside the call, long after the lender has
+//! moved on to the object.
+//!
+//! [`Handoff`] is that answer, kept by the lender. The borrower holds the other
+//! half, [`HandBack`], and settles it exactly once, after the call and after
+//! everything a waiter must see with it — a failure the call returned, for one,
+//! because a failed call leaves its object exactly where it was and a waiter
+//! that missed the failure would wait for a signal nothing will send.
+//!
+//! # A call that will never be made is not outstanding
+//!
+//! Dropping a [`HandBack`] unsettled — the request discarded with the thread
+//! that would have made the call — is [`HostCall::Abandoned`]. A waiter learns
+//! that at once instead of at a deadline, and what it means for the object is
+//! the executor's to say.
+//!
+//! # A deadline is an answer, not a hang
+//!
+//! [`Handoff::wait`] takes one. A borrower stuck inside the call surfaces as
+//! [`HostCall::Outstanding`] at the deadline, which the executor reports the way
+//! it reports any wedged host wait; a lender is never parked for good on a
+//! borrower that stopped.
+//!
+//! The model names no host object: what is lent, and what each outcome means for
+//! it, belong to the executor holding the two halves.
+
+use std::sync::{Arc, Condvar, Mutex};
+use std::time::Duration;
+
+/// Where a lent host call stands.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum HostCall {
+    /// Queued behind the borrower, or inside the call: the object is not the
+    /// lender's.
+    Outstanding,
+    /// The call came back, whatever it returned; anything the borrower settles
+    /// before handing back is visible with this.
+    Returned,
+    /// The call was never made and never will be.
+    Abandoned,
+}
+
+#[derive(Debug)]
+struct Latch {
+    call: Mutex<HostCall>,
+    changed: Condvar,
+}
+
+impl Latch {
+    /// Leave `Outstanding` exactly once; a later settle changes nothing.
+    fn settle(&self, to: HostCall) {
+        let mut call = self.call.lock().unwrap_or_else(|e| e.into_inner());
+        if *call == HostCall::Outstanding {
+            *call = to;
+            self.changed.notify_all();
+        }
+    }
+}
+
+/// The lender's half: whether the host call that holds the object is over.
+#[derive(Debug)]
+pub struct Handoff(Option<Arc<Latch>>);
+
+/// The borrower's half, settled once after the call.
+#[derive(Debug)]
+pub struct HandBack(Arc<Latch>);
+
+impl Handoff {
+    /// Nothing outstanding: the call already returned on the lender's own
+    /// thread, or the object was never lent.
+    pub const RETURNED: Self = Self(None);
+
+    /// Lend an object for one host call.
+    pub fn lend() -> (Self, HandBack) {
+        let latch = Arc::new(Latch {
+            call: Mutex::new(HostCall::Outstanding),
+            changed: Condvar::new(),
+        });
+        (Self(Some(Arc::clone(&latch))), HandBack(latch))
+    }
+
+    /// Where the call stands now. Never blocks.
+    pub fn state(&self) -> HostCall {
+        match &self.0 {
+            None => HostCall::Returned,
+            Some(latch) => *latch.call.lock().unwrap_or_else(|e| e.into_inner()),
+        }
+    }
+
+    /// Block while the call is outstanding, for at most `deadline`, and say
+    /// where it stands. `Outstanding` means the deadline passed first.
+    pub fn wait(&self, deadline: Duration) -> HostCall {
+        let Some(latch) = &self.0 else {
+            return HostCall::Returned;
+        };
+        let call = latch.call.lock().unwrap_or_else(|e| e.into_inner());
+        let (call, _) = latch
+            .changed
+            .wait_timeout_while(call, deadline, |call| *call == HostCall::Outstanding)
+            .unwrap_or_else(|e| e.into_inner());
+        *call
+    }
+}
+
+/// Two handoffs are equal when they lend for the same call.
+impl PartialEq for Handoff {
+    fn eq(&self, other: &Self) -> bool {
+        match (&self.0, &other.0) {
+            (None, None) => true,
+            (Some(a), Some(b)) => Arc::ptr_eq(a, b),
+            _ => false,
+        }
+    }
+}
+
+impl Eq for Handoff {}
+
+impl HandBack {
+    /// The call is over; the object is the lender's again.
+    pub fn returned(self) {
+        self.0.settle(HostCall::Returned);
+    }
+}
+
+impl Drop for HandBack {
+    fn drop(&mut self) {
+        self.0.settle(HostCall::Abandoned);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Lent is not returned, and only the borrower changes that.
+    #[test]
+    fn a_lent_object_is_outstanding_until_handed_back() {
+        let (handoff, back) = Handoff::lend();
+        assert_eq!(handoff.state(), HostCall::Outstanding);
+
+        back.returned();
+
+        assert_eq!(handoff.state(), HostCall::Returned);
+        assert_eq!(handoff.wait(Duration::ZERO), HostCall::Returned);
+    }
+
+    /// The lender is typically another thread, blocked until the call is over.
+    #[test]
+    fn a_waiter_on_another_thread_wakes_when_the_call_returns() {
+        let (handoff, back) = Handoff::lend();
+        let waiter = std::thread::spawn(move || handoff.wait(Duration::from_secs(5)));
+
+        std::thread::sleep(Duration::from_millis(20));
+        back.returned();
+
+        assert_eq!(waiter.join().expect("waiter"), HostCall::Returned);
+    }
+
+    /// A borrower stuck inside the call bounds the wait instead of parking the
+    /// lender.
+    #[test]
+    fn a_stalled_borrower_is_still_outstanding_at_the_deadline() {
+        let (handoff, _inside_the_call) = Handoff::lend();
+        let started = std::time::Instant::now();
+
+        assert_eq!(
+            handoff.wait(Duration::from_millis(20)),
+            HostCall::Outstanding
+        );
+        assert!(started.elapsed() >= Duration::from_millis(20));
+        assert_eq!(handoff.state(), HostCall::Outstanding);
+    }
+
+    /// A call that will never be made is said so at once, not at a deadline.
+    #[test]
+    fn a_dropped_hand_back_abandons_the_call() {
+        let (handoff, back) = Handoff::lend();
+        drop(back);
+
+        let started = std::time::Instant::now();
+        assert_eq!(handoff.wait(Duration::from_secs(5)), HostCall::Abandoned);
+        assert!(started.elapsed() < Duration::from_secs(1));
+        assert_eq!(handoff.state(), HostCall::Abandoned);
+    }
+
+    /// Settling is once: neither a late drop nor anything else moves it back.
+    #[test]
+    fn a_returned_call_stays_returned() {
+        let (handoff, back) = Handoff::lend();
+        back.returned();
+        assert_eq!(handoff.state(), HostCall::Returned);
+        assert_eq!(handoff.wait(Duration::from_secs(5)), HostCall::Returned);
+    }
+
+    /// Nothing outstanding needs no latch and never blocks.
+    #[test]
+    fn returned_has_nothing_outstanding() {
+        assert_eq!(Handoff::RETURNED.state(), HostCall::Returned);
+        assert_eq!(Handoff::RETURNED.wait(Duration::ZERO), HostCall::Returned);
+        assert_eq!(Handoff::RETURNED, Handoff::RETURNED);
+        let (one, _back_one) = Handoff::lend();
+        let (two, _back_two) = Handoff::lend();
+        assert_ne!(one, two, "two lends are two calls");
+        assert_eq!(one, one);
+    }
+}
