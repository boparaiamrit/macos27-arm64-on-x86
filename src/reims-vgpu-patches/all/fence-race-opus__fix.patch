+/// A ring fence is the queue owner's until the owner is back from the
+/// `vkQueueSubmit` that took it.
+///
+/// A batch leaves the drain worker at the handoff, before that call has even
+/// started, and Vulkan makes the submitted fence externally synchronized for
+/// the call's whole length. A drain-side wait that starts first is what the R8
+/// qualification's `held-open-off` case caught: `vkQueueSubmit(): THREADING
+/// ERROR : object of type VkFence is simultaneously used in current thread …`,
+/// the owner submitting a fence the joined readback was already waiting on.
+///
+/// The owner is parked behind a hold so the order is not left to the
+/// scheduler: the handoff sits in its FIFO while the drain side reaches the
+/// fence, and a third thread releases the hold. The Khronos threading layer is
+/// the judge of a two-thread use, and each test listens for it in-process
+/// (`context::validation_capture::Listening`), so a ring that touches the fence
+/// early fails here on every run rather than only in the gate's reading of the
+/// log.
+#[cfg(test)]
+mod ring_fence_handoff_tests {
+    use super::*;
+    use crate::backend::vulkan::engine::context::validation_capture;
+    use crate::backend::vulkan::engine::queue_owner::OwnerHold;
+    use ash::vk::Handle;
+
+    /// Long enough that the drain side is certainly inside its wait first.
+    const RELEASE_AFTER: std::time::Duration = std::time::Duration::from_millis(200);
+
+    /// Open a one-entry batch the way a deferred draw does: claim the slot,
+    /// begin it, append.
+    unsafe fn open_batch(
+        ctx: &DeviceContext,
+        pools: &mut ResourcePools,
+        counters: &EngineCounters,
+    ) -> vk::Fence {
+        let slot = unsafe { pools.begin_entry(ctx, counters) }.expect("ring slot");
+        unsafe {
+            pools.begin_slot_recording(
+                ctx,
+                slot.0,
+                gpu_span::Kind::Draw,
+                VkOp::ExecResetCb,
+                VkOp::ExecBeginCb,
+            )
+        }
+        .expect("recording batch");
+        let target = BatchTarget {
+            identity: TargetIdentity::Gva {
+                gva: 0xfe0000,
+                width: 4,
+                height: 4,
+                generation: 1,
+                format: vk::Format::R8G8B8A8_UNORM,
+            },
+            width: 4,
+            height: 4,
+            bgra: false,
+        };
+        unsafe { pools.batch_append(&ctx.device, slot, target, None, Vec::new(), counters) };
+        slot.1
+    }
+
+    fn release_later(hold: OwnerHold) -> std::thread::JoinHandle<()> {
+        std::thread::spawn(move || {
+            std::thread::sleep(RELEASE_AFTER);
+            drop(hold);
+        })
+    }
+
+    fn async_submits_returned(ctx: &DeviceContext) -> u64 {
+        ctx.queue_owner
+            .as_ref()
+            .expect("these tests are about the queue owner")
+            .stats()
+            .0
+    }
+
+    /// Listen for the layer's reports. Where the layer is loaded they must be
+    /// heard, or the threading check would pass by not listening.
+    fn listen(ctx: &DeviceContext) -> Option<validation_capture::Listening> {
+        let layer = std::fs::read_to_string("/proc/self/maps")
+            .is_ok_and(|maps| maps.contains("libVkLayer_khronos_validation"));
+        let listening = validation_capture::Listening::start(ctx);
+        let heard = listening.is_some();
+        eprintln!("RING_FENCE_VALIDATION_CAPTURE layer={layer} listening={heard}");
+        assert!(
+            !layer || heard,
+            "the validation layer is loaded but its reports are not heard"
+        );
+        listening
+    }
+
+    /// The threading layer's reports that name `fence`.
+    fn threading_reports_on(fence: vk::Fence) -> Vec<String> {
+        validation_capture::errors()
+            .into_iter()
+            .filter(|report| {
+                report.id.starts_with("UNASSIGNED-Threading")
+                    && report.objects.contains(&fence.as_raw())
