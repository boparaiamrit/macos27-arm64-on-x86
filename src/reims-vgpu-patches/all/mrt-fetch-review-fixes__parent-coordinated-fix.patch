+    #[derive(Default)]
+    struct ScriptedApi {
+        next_pool: u64,
+        next_set: u64,
+        create_results: VecDeque<Result<(), vk::Result>>,
+        allocate_results: VecDeque<Result<(), vk::Result>>,
+        free_results: VecDeque<Result<(), vk::Result>>,
+        creates: Vec<(u32, u32, Vec<(i32, u32)>)>,
+        allocs: Vec<u64>,
+        frees: Vec<(u64, Vec<u64>)>,
+        destroys: Vec<u64>,
+        live: HashSet<u64>,
+        owners: HashMap<u64, u64>,
+    }
+    impl ScriptedApi {
+        fn new() -> Self {
+            Self {
+                next_pool: 1,
+                next_set: 100,
+                ..Default::default()
+            }
+        }
+    }
+    impl PoolApi for ScriptedApi {
+        unsafe fn create_pool(
+            &mut self,
+            info: &vk::DescriptorPoolCreateInfo<'_>,
+        ) -> Result<vk::DescriptorPool, vk::Result> {
+            let sizes = unsafe {
+                std::slice::from_raw_parts(info.p_pool_sizes, info.pool_size_count as usize)
+            };
+            self.creates.push((
+                info.flags.as_raw(),
+                info.max_sets,
+                sizes
+                    .iter()
+                    .map(|s| (s.ty.as_raw(), s.descriptor_count))
+                    .collect(),
+            ));
+            self.create_results.pop_front().unwrap_or(Ok(()))?;
+            let id = self.next_pool;
+            self.next_pool += 1;
+            assert!(self.live.insert(id));
+            Ok(vk::DescriptorPool::from_raw(id))
+        }
+        unsafe fn allocate_sets(
+            &mut self,
+            info: &vk::DescriptorSetAllocateInfo<'_>,
+        ) -> Result<Vec<vk::DescriptorSet>, vk::Result> {
+            let pool = info.descriptor_pool.as_raw();
+            assert!(self.live.contains(&pool));
+            assert_eq!(info.descriptor_set_count, 1);
+            self.allocs.push(pool);
+            self.allocate_results.pop_front().unwrap_or(Ok(()))?;
+            let id = self.next_set;
+            self.next_set += 1;
+            assert!(self.owners.insert(id, pool).is_none());
+            Ok(vec![vk::DescriptorSet::from_raw(id)])
+        }
+        unsafe fn free_sets(
+            &mut self,
+            pool: vk::DescriptorPool,
