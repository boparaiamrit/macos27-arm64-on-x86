+/// A guest-CPU `RGBA16Unorm` linear texture with a declared mip chain — the
+/// shape the Golden Gate guest's full-screen draw samples (five levels, a
+/// 260-byte descriptor, tight rows) — loads on the byte rung at its own eight
+/// bytes a texel, every channel exact.
+///
+/// The rung uploads one 2D image, as it does for every format: the image is the
+/// base level, which is the level a magnified sample reads. The values cover
+/// both ends of each channel's range and adjacent words (65534/65535), which an
+/// eight-bit or half-float path would merge.
+#[cfg(feature = "backend-vulkan")]
+#[test]
+fn rgba16_unorm_mip_chain_linear_texture_loads_its_base_level_natively() {
+    use crate::protocol::endian::{st16, st32, st64};
+    use crate::protocol::pixel_format::MTL_FORMAT_RGBA16_UNORM;
+    use crate::runtime::decode::resource::{
+        list_object_entry_offset, LINEAR_DESC_HANDLE, LINEAR_DESC_SIZE, OBJECT_LIST_ENTRY_LEN,
+        RESOURCE_PAGE_SHIFT, TEXTURE_DESC_BASE_LEN, TEXTURE_DESC_HEIGHT,
+        TEXTURE_DESC_LEVEL_RECORDS, TEXTURE_DESC_MIPMAP_LEVEL_COUNT,
+        TEXTURE_DESC_MIP_LEVEL_RECORD_LEN, TEXTURE_DESC_PIXEL_FORMAT, TEXTURE_DESC_ROW_STRIDE,
+        TEXTURE_DESC_USED_SIZE, TEXTURE_DESC_WIDTH, TEXTURE_LEVEL_HEIGHT, TEXTURE_LEVEL_OFFSET,
+        TEXTURE_LEVEL_ROW_STRIDE, TEXTURE_LEVEL_SIZE, TEXTURE_LEVEL_WIDTH,
+    };
+    use crate::runtime::gva_mem;
+    use reims_vgpu_protocol::extent::mip_extent;
+
+    const BASE: u32 = 16;
+    const LEVELS: u32 = 5; // 16, 8, 4, 2, 1
+    const BPP: u32 = 8;
+    let stride = |level: u32| u64::from(mip_extent(BASE, level) * BPP);
+
+    let mut host = FakeHost::new();
+    let mut state = DeviceState::new(DeviceId(1), PAGE_SHIFT_ARM64E);
+    gva_mem::define_task_pages_arm64e(&mut host, &mut state, 4, 8);
+    assert!(state.set_object_list(1, 0, 32));
+
+    // Level 0 carries the checked words; the smaller levels carry a marker the
+    // base-level read must not return.
+    let words: [u16; 8] = [0, 1, 32767, 32768, 65534, 65535, 0x1234, 0xfedc];
+    let handle = 5u64;
+    let base_gva = handle << RESOURCE_PAGE_SHIFT;
+    let mut offsets = Vec::new();
+    let mut image = Vec::new();
+    let mut level0 = Vec::new();
+    for level in 0..LEVELS {
+        offsets.push(image.len() as u64);
+        let side = mip_extent(BASE, level);
+        for y in 0..side {
+            for x in 0..side {
+                for c in 0..4u32 {
+                    let word = if level == 0 {
+                        words[((x + y + c) % 8) as usize]
+                    } else {
+                        0xA5A5
+                    };
+                    image.extend_from_slice(&word.to_le_bytes());
+                    if level == 0 {
+                        level0.extend_from_slice(&word.to_le_bytes());
+                    }
+                }
+            }
+        }
+    }
+    let allocation_size = 1u64 << RESOURCE_PAGE_SHIFT;
+    assert!(image.len() as u64 <= allocation_size);
+    write_task_gva_arm64e(&mut host, &state.tasks[1], base_gva, &image);
+
+    let desc_len =
+        TEXTURE_DESC_BASE_LEN + (LEVELS as usize - 1) * TEXTURE_DESC_MIP_LEVEL_RECORD_LEN;
+    assert_eq!(desc_len, 260, "the guest's five-level descriptor length");
+    let mut desc = vec![0u8; desc_len];
+    st64(&mut desc[LINEAR_DESC_SIZE..], allocation_size);
+    st64(&mut desc[LINEAR_DESC_HANDLE..], handle);
+    desc[TEXTURE_DESC_MIPMAP_LEVEL_COUNT] = LEVELS as u8;
+    st32(
+        &mut desc[TEXTURE_DESC_USED_SIZE..],
+        (stride(0) * u64::from(BASE)) as u32,
+    );
+    st32(&mut desc[TEXTURE_DESC_ROW_STRIDE..], stride(0) as u32);
+    st32(&mut desc[TEXTURE_DESC_WIDTH..], BASE);
+    st32(&mut desc[TEXTURE_DESC_HEIGHT..], BASE);
+    for level in 1..LEVELS {
+        let rec =
+            TEXTURE_DESC_LEVEL_RECORDS + (level as usize - 1) * TEXTURE_DESC_MIP_LEVEL_RECORD_LEN;
+        let side = mip_extent(BASE, level);
+        st64(
+            &mut desc[rec + TEXTURE_LEVEL_OFFSET..],
+            offsets[level as usize],
+        );
+        st64(
+            &mut desc[rec + TEXTURE_LEVEL_SIZE..],
+            stride(level) * u64::from(side),
+        );
+        st64(&mut desc[rec + TEXTURE_LEVEL_ROW_STRIDE..], stride(level));
+        st32(&mut desc[rec + TEXTURE_LEVEL_WIDTH..], side);
+        st32(&mut desc[rec + TEXTURE_LEVEL_HEIGHT..], side);
+    }
+    let pf_off =
+        TEXTURE_DESC_PIXEL_FORMAT + (LEVELS as usize - 1) * TEXTURE_DESC_MIP_LEVEL_RECORD_LEN;
+    st16(&mut desc[pf_off..], MTL_FORMAT_RGBA16_UNORM);
+    let desc_gva = 0x2000u64;
+    write_task_gva_arm64e(&mut host, &state.tasks[1], desc_gva, &desc);
+    let tex_ref = 11u32;
+    let off = list_object_entry_offset(tex_ref, 32).unwrap();
+    let mut le = [0u8; OBJECT_LIST_ENTRY_LEN];
+    st32(
+        &mut le[0..],
+        (OBJECT_TYPE_TEXTURE as u32) | ((desc.len() as u32) << 8),
+    );
+    le[4..12].copy_from_slice(&desc_gva.to_le_bytes());
+    write_task_gva_arm64e(&mut host, &state.tasks[1], off, &le);
+
+    let le_entry = objects::lookup_list_entry(&state, &host, 1, tex_ref)
+        .expect("object-list entry must resolve");
+    let td = decode_texture_descriptor(
+        &objects::read_descriptor(&state, &host, 1, &le_entry).expect("descriptor must read"),
+    )
+    .expect("descriptor must decode");
+    assert_eq!(td.mipmap_level_count, LEVELS);
+    assert_eq!(td.declared_pixel_format(), Some(MTL_FORMAT_RGBA16_UNORM));
+
+    let (w, h, bytes, identity, format) =
+        load_linear_from_host_caches(&mut state, &mut host, 1, tex_ref, &td)
+            .expect("an RGBA16Unorm linear texture must load on the byte rung");
+    assert_eq!((w, h), (BASE, BASE));
+    assert_eq!(
+        format,
+        SampledByteFormat::from_source(TexelLayout::Rgba16Unorm, MTL_FORMAT_RGBA16_UNORM),
+        "uploaded at its own eight bytes, never narrowed"
+    );
+    assert_eq!(
+        bytes.as_slice(),
+        level0.as_slice(),
+        "the base level's words, exact"
+    );
+    assert!(identity.is_some(), "the memo carries a content identity");
+}
