+/// A four-channel sixteen-bit normalized linear texture binds natively, and
+/// only natively.
+///
+/// The Golden Gate defect: a full-screen WindowServer draw samples a 128x128
+/// `RGBA16Unorm` linear texture and every bind was refused with
+/// `draw_prepare_texture_resolve_missing … reason=linear_sample`. On a host
+/// with no stable guest-page alias the zero-copy rung is off, and the byte
+/// rungs had neither a native layout nor a convert arm for the format. The
+/// native layout is the guest's own eight bytes; there is still no convert arm,
+/// because an eight-bit one would drop the low byte of every channel.
+#[test]
+fn a_sixteen_bit_normalized_sampled_texture_is_native_or_refused() {
+    assert_eq!(
+        linear_native_upload_format(pixel_format::MTL_FORMAT_RGBA16_UNORM, NativeUploads::ALL),
+        Some(TexelLayout::Rgba16Unorm)
+    );
+    assert_eq!(
+        linear_native_upload_format(pixel_format::MTL_FORMAT_RGBA16_UNORM, NativeUploads::BGRA8),
+        None,
+        "a host that cannot sample it must not get a native bind"
+    );
+    assert_eq!(
+        linear_native_upload_format(pixel_format::MTL_FORMAT_RGBA16_UNORM, NativeUploads::NONE),
+        None
+    );
+    assert_eq!(TexelLayout::Rgba16Unorm.bytes_per_texel(), 8);
+    assert!(!TexelLayout::Rgba16Unorm.has_cpu_loader_arm());
+    assert!(pixel_format::RowToRgba8::for_format(pixel_format::MTL_FORMAT_RGBA16_UNORM).is_none());
+}
