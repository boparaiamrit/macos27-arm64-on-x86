+/// The same captured memoryless shape declaring `MTLLoadActionClear`, which the
+/// Golden Gate guest does (`rt_resolve reason=rt_memoryless_load_action value=2`).
+/// Clear reads no prior contents, so it is inside the memoryless contract: the
+/// attachment resolves and the request clears to the declared colour, still
+/// with no seed from guest pages.
+#[test]
+fn mrt_draw_request_memoryless_clear_is_seedless_and_carries_its_colour() {
+    use crate::protocol::endian::st32;
+    use crate::protocol::pass_action::MTL_LOAD_ACTION_CLEAR;
+    use crate::runtime::decode::resource::{list_object_entry_offset, OBJECT_LIST_ENTRY_LEN};
+    use crate::runtime::gva_mem;
+    use crate::runtime::render_pass::ColorAttachment;
+
+    let mut state = DeviceState::new(DeviceId(1), PAGE_SHIFT_ARM64E);
+    let mut host = FakeHost::new();
+    gva_mem::define_task_pages_arm64e(&mut host, &mut state, 4, 16);
+    assert!(state.set_object_list(1, 0, 256));
+    let tex_ref = 201u32;
+    let words: [u32; 11] = [
+        1,
+        44,
+        tex_ref,
+        0x0073_0542,
+        1920,
+        1080,
+        1,
+        0x0001_0001,
+        0x0030_0001,
+        0,
+        0,
+    ];
+    let mut desc = vec![0u8; 44];
+    for (i, word) in words.iter().enumerate() {
+        st32(&mut desc[i * 4..], *word);
+    }
+    write_task_gva_arm64e(&mut host, &state.tasks[1], 0x280, &desc);
+    let off = list_object_entry_offset(tex_ref, 256).expect("ref is inside the list");
+    let mut entry = [0u8; OBJECT_LIST_ENTRY_LEN];
+    st32(&mut entry[0..], 9 | ((desc.len() as u32) << 8));
+    entry[4..12].copy_from_slice(&0x280u64.to_le_bytes());
+    write_task_gva_arm64e(&mut host, &state.tasks[1], off, &entry);
+
+    let clear_color = [0.25, 0.5, 0.75, 1.0];
+    let att = ColorAttachment {
+        texture_ref: tex_ref,
+        resolve_texture_ref: 0,
+        level: 0,
+        slice: 0,
+        depth_plane: 0,
+        load_action: MTL_LOAD_ACTION_CLEAR,
+        store_action: 0,
+        clear_color,
+    };
+    let slots = [(0u32, att)];
+    let captured = crate::observe::FailCapture::start();
+    let req = mrt_draw_request(&mut state, &mut host, 1, 1, &slots, &[], test_triangle())
+        .expect("a memoryless Clear is inside the contract and must build a draw request");
+    assert!(
+        captured
+            .lines()
+            .iter()
+            .all(|line| !line.contains("rt_memoryless_load_action")),
+        "Clear is not a refused memoryless load action: {:?}",
+        captured.lines()
+    );
+    assert!(req.colors[0].memoryless);
+    assert!(req.memoryless_pass.is_some());
+    assert!(
+        req.colors[0].target_seed_rgba.is_none(),
+        "the clear is the engine's attachment clear, never a seed from guest pages"
+    );
+    assert_eq!(req.colors[0].load_action, MTL_LOAD_ACTION_CLEAR);
+    assert_eq!(req.colors[0].clear_color, clear_color);
+    assert_eq!(
+        (
+            req.colors[0].width,
+            req.colors[0].height,
+            req.colors[0].format
+        ),
+        (1920, 1080, 0x73)
+    );
+}
