+/// Make everything this subpass wrote visible to the next primitive's reads.
+///
+/// # Safety
+///
+/// `cb` is recording inside a render pass instance whose subpass carries the
+/// framebuffer-fetch self-dependency built from [`INPUT_ORDER_SRC`] and
+/// [`INPUT_ORDER_DST`], which every pass with colour inputs does.
+pub(crate) unsafe fn record_primitive_barrier(device: &ash::Device, cb: vk::CommandBuffer) {
+    let barrier = [vk::MemoryBarrier::default()
+        .src_access_mask(INPUT_ORDER_SRC.1)
+        .dst_access_mask(INPUT_ORDER_DST.1)];
+    unsafe {
+        device.cmd_pipeline_barrier(
+            cb,
+            INPUT_ORDER_SRC.0,
+            INPUT_ORDER_DST.0,
+            vk::DependencyFlags::BY_REGION,
+            &barrier,
+            &[],
+            &[],
+        )
+    };
