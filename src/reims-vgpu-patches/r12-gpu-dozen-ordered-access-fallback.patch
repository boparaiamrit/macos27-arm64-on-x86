+/// `Decoration BuiltIn`.
+const DECORATION_BUILT_IN: u32 = 11;
+/// The built-ins whose values change, or whose facing a reversed winding
+/// changes, when a draw is recorded one primitive at a time; see
+/// `backend::vulkan::engine::color_input`.
+pub const BUILTIN_PRIMITIVE_ID: u32 = 7;
+pub const BUILTIN_FRONT_FACING: u32 = 17;
+pub const BUILTIN_BASE_VERTEX: u32 = 4424;
+pub const BUILTIN_BASE_INSTANCE: u32 = 4425;
+
+/// Whether the module declares a variable, or a block member, decorated
+/// `BuiltIn builtin`.
+///
+/// Declaration rather than use, on purpose: the caller refuses a draw whose
+/// split would change what a module could read, and a declared built-in is one
+/// it could. A stream that does not decode answers `true` for the same reason —
+/// nothing may be promised about a module this cannot read.
+pub fn declares_builtin(words: &[u32], builtin: u32) -> bool {
+    let Some(instrs) = instructions(words) else {
+        return true;
+    };
+    for &Instruction {
+        opcode,
+        word_count,
+        at: i,
+    } in &instrs
+    {
+        let decoration = match opcode {
+            OP_DECORATE if word_count >= 4 => &words[i + 2..i + 4],
+            OP_MEMBER_DECORATE if word_count >= 5 => &words[i + 3..i + 5],
+            _ => continue,
+        };
+        if decoration == [DECORATION_BUILT_IN, builtin] {
+            return true;
+        }
+    }
+    false
+}
