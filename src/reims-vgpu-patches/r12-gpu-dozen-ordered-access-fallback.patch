+    /// Follows the first vertex of a non-indexed draw.
+    BaseVertex,
+    /// Follows the first instance.
+    BaseInstance,
+}
+impl SplitBuiltin {
+    fn slug(self) -> &'static str {
+        match self {
+            Self::PrimitiveId => "primitive_id",
+            Self::BaseVertex => "base_vertex",
+            Self::BaseInstance => "base_instance",
+        }
+    }
+}
+
+/// What a reversed-winding strip triangle would change.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum FacingTerm {
+    Cull,
+    TwoSidedStencil,
+    FrontFacingRead,
+}
+impl FacingTerm {
+    fn slug(self) -> &'static str {
+        match self {
+            Self::Cull => "cull",
+            Self::TwoSidedStencil => "two_sided_stencil",
+            Self::FrontFacingRead => "front_facing",
+        }
+    }
+}
+
+/// Which split-observable built-ins the draw's two modules declare. Declared
+/// counts as read: a refusal is cheaper than a proof of dead code.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub(crate) struct SplitReads {
+    pub(crate) primitive_id: bool,
+    pub(crate) base_vertex: bool,
+    pub(crate) base_instance: bool,
+    pub(crate) front_facing: bool,
+}
+impl SplitReads {
+    /// Read off the two translated modules.
+    pub(crate) fn of(vertex: &[u32], fragment: &[u32]) -> Self {
+        use crate::runtime::spirv_bind::{
+            declares_builtin, BUILTIN_BASE_INSTANCE, BUILTIN_BASE_VERTEX,
+        };
+        use crate::runtime::spirv_bind::{BUILTIN_FRONT_FACING, BUILTIN_PRIMITIVE_ID};
+        let either =
+            |builtin| declares_builtin(vertex, builtin) || declares_builtin(fragment, builtin);
+        Self {
+            primitive_id: either(BUILTIN_PRIMITIVE_ID),
+            base_vertex: either(BUILTIN_BASE_VERTEX),
+            base_instance: either(BUILTIN_BASE_INSTANCE),
+            front_facing: either(BUILTIN_FRONT_FACING),
+        }
+    }
+}
+
+/// The facts about one draw the per-primitive rung needs, read from the
+/// request and its two translated modules.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) struct DrawShape {
+    pub(crate) topology: PrimitiveType,
+    /// Indices for an indexed draw, vertices otherwise.
+    pub(crate) elements: u32,
+    /// First vertex of a non-indexed draw; zero for an indexed one, whose
+    /// first index is zero in this engine.
+    pub(crate) first: u32,
+    pub(crate) instances: u32,
+    pub(crate) base_instance: u32,
+    pub(crate) indexed: bool,
+    /// `MTLCullMode` other than none.
+    pub(crate) culls: bool,
+    /// `MTLTriangleFillMode` other than fill.
+    pub(crate) wireframe: bool,
+    /// The two stencil faces differ in ops or reference.
+    pub(crate) two_sided_stencil: bool,
+    pub(crate) reads: SplitReads,
+}
+
+/// One primitive's draw, in the original draw's own coordinates.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) struct PrimitiveDraw {
+    pub(crate) first_instance: u32,
+    /// First index of an indexed draw, first vertex otherwise.
+    pub(crate) first: u32,
+    pub(crate) count: u32,
+}
+
+/// Draws one guest draw may expand into on the per-primitive rung. Each is a
+/// barrier and a draw; the bound keeps a pathological guest draw from turning
+/// into an unbounded command buffer, and refusing past it names the count.
+pub(crate) const MAX_PRIMITIVE_DRAWS: u64 = 4096;
+
+/// A draw recorded as its primitives, in primitive order: every primitive of
+/// instance 0, then of instance 1, and so on.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) struct PrimitiveSplit {
+    span: u32,
+    stride: u32,
+    primitives: u32,
+    shape: DrawShape,
+}
+impl PrimitiveSplit {
+    pub(crate) fn plan(shape: DrawShape) -> Result<Self, DrawError> {
+        let (span, stride) = match shape.topology {
+            PrimitiveType::Point => (1, 1),
+            PrimitiveType::Line => (2, 2),
+            PrimitiveType::LineStrip => (2, 1),
+            PrimitiveType::Triangle => (3, 3),
+            PrimitiveType::TriangleStrip => (3, 1),
+        };
+        let primitives = if shape.elements < span {
+            0
+        } else {
+            (shape.elements - span) / stride + 1
+        };
+        let split = Self {
+            span,
+            stride,
+            primitives,
+            shape,
+        };
+        let draws = split.len();
+        if draws == 0 {
+            return Ok(split);
+        }
+        let builtin = |builtin| refusal(ColorInputDecline::UnorderedBuiltinObservable { builtin });
+        if shape.reads.primitive_id && draws > 1 {
+            return Err(builtin(SplitBuiltin::PrimitiveId));
+        }
+        if shape.reads.base_vertex && !shape.indexed && primitives > 1 {
+            return Err(builtin(SplitBuiltin::BaseVertex));
+        }
+        if shape.reads.base_instance && shape.instances > 1 {
+            return Err(builtin(SplitBuiltin::BaseInstance));
+        }
+        if shape.wireframe && shape.topology.class() == TopologyClass::Triangle {
+            return Err(refusal(ColorInputDecline::UnorderedWireframe));
+        }
+        if shape.topology == PrimitiveType::TriangleStrip && primitives > 1 {
+            let facing = |term| refusal(ColorInputDecline::UnorderedStripFacing { term });
+            if shape.culls {
+                return Err(facing(FacingTerm::Cull));
+            }
+            if shape.two_sided_stencil {
+                return Err(facing(FacingTerm::TwoSidedStencil));
+            }
+            if shape.reads.front_facing {
+                return Err(facing(FacingTerm::FrontFacingRead));
+            }
+        }
+        let fits = shape.first.checked_add(shape.elements).is_some()
+            && shape.base_instance.checked_add(shape.instances).is_some();
+        if draws > MAX_PRIMITIVE_DRAWS || !fits {
+            return Err(refusal(ColorInputDecline::UnorderedSplitLimit {
+                draws,
+                limit: MAX_PRIMITIVE_DRAWS,
+            }));
+        }
+        Ok(split)
+    }
+    pub(crate) fn len(self) -> u64 {
+        u64::from(self.primitives) * u64::from(self.shape.instances)
+    }
+    pub(crate) fn draws(self) -> impl Iterator<Item = PrimitiveDraw> {
+        let Self {
+            span,
+            stride,
+            primitives,
+            shape,
+        } = self;
+        (0..shape.instances).flat_map(move |instance| {
+            (0..primitives).map(move |primitive| PrimitiveDraw {
+                first_instance: shape.base_instance + instance,
+                first: shape.first + primitive * stride,
+                count: span,
+            })
+        })
+    }
+}
