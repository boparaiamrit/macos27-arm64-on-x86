+#[cfg(test)]
+mod per_primitive_tests {
+    use super::*;
+
+    fn caps(ordered: bool) -> DeviceFeatures {
+        DeviceFeatures {
+            ordered_color_attachment_access: ordered,
+            max_color_attachments: 8,
+            input_attachment_stage_limit: 8,
+            input_attachment_descriptor_limit: 8,
+            ..Default::default()
+        }
+    }
+
+    fn shape(topology: PrimitiveType, elements: u32) -> DrawShape {
+        DrawShape {
+            topology,
+            elements,
+            first: 0,
+            instances: 1,
+            base_instance: 0,
+            indexed: true,
+            culls: false,
+            wireframe: false,
+            two_sided_stencil: false,
+            reads: SplitReads::default(),
+        }
+    }
+
+    fn decline(result: Result<PrimitiveSplit, DrawError>) -> ColorInputDecline {
+        match result {
+            Err(DrawError::Unsupported(DrawReason::ColorInput(decline))) => decline,
+            other => panic!("expected a colour-input refusal, got {other:?}"),
+        }
+    }
+
+    /// The extension's flags exist only where the extension does. A
+    /// per-primitive pass naming them would be invalid usage on exactly the
+    /// hosts that rung is for.
+    #[test]
+    fn the_rasterization_order_flags_belong_to_the_extension_rung_only() {
+        let inputs = ColorInputs::parse([0, 1]).unwrap();
+        let ordered = OrderedColorInputs::admit(inputs, &caps(true), 2).unwrap();
+        let split = OrderedColorInputs::admit(inputs, &caps(false), 2).unwrap();
+        assert!(!ordered.subpass_flags().is_empty() && !ordered.blend_flags().is_empty());
+        assert!(split.subpass_flags().is_empty() && split.blend_flags().is_empty());
+        // The two rungs are different passes and pipelines, never one cache entry.
+        assert_ne!(ordered, split);
+        assert!(!OrderedColorInputs::default().per_primitive());
+    }
+
+    /// One draw per primitive, in primitive order, each starting where the
+    /// original draw's primitive started. Counts per topology follow Vulkan's
+    /// primitive definitions; trailing elements that complete no primitive draw
+    /// nothing either way.
+    #[test]
+    fn every_topology_splits_into_its_own_primitives_in_order() {
+        let windows = |s: DrawShape| -> Vec<(u32, u32)> {
+            PrimitiveSplit::plan(s)
+                .unwrap()
+                .draws()
+                .map(|d| (d.first, d.count))
+                .collect()
+        };
+        assert_eq!(windows(shape(PrimitiveType::Triangle, 6)), [(0, 3), (3, 3)]);
+        assert_eq!(windows(shape(PrimitiveType::Triangle, 8)), [(0, 3), (3, 3)]);
+        assert_eq!(
+            windows(shape(PrimitiveType::TriangleStrip, 5)),
+            [(0, 3), (1, 3), (2, 3)]
+        );
+        assert_eq!(windows(shape(PrimitiveType::Line, 5)), [(0, 2), (2, 2)]);
+        assert_eq!(
+            windows(shape(PrimitiveType::LineStrip, 3)),
+            [(0, 2), (1, 2)]
+        );
+        assert_eq!(
+            windows(shape(PrimitiveType::Point, 3)),
+            [(0, 1), (1, 1), (2, 1)]
+        );
+        assert!(windows(shape(PrimitiveType::Triangle, 2)).is_empty());
+        assert!(windows(shape(PrimitiveType::TriangleStrip, 0)).is_empty());
+    }
+
+    /// Instances keep their order and their own instance index; a non-indexed
+    /// draw keeps its own first vertex, so `VertexIndex` is unchanged.
+    #[test]
+    fn instances_and_first_vertex_are_carried_into_every_primitive_draw() {
+        let s = DrawShape {
+            first: 10,
+            instances: 2,
+            base_instance: 5,
+            indexed: false,
+            ..shape(PrimitiveType::Triangle, 6)
+        };
+        let draws: Vec<_> = PrimitiveSplit::plan(s).unwrap().draws().collect();
+        let expect = |first_instance, first| PrimitiveDraw {
+            first_instance,
+            first,
+            count: 3,
+        };
+        assert_eq!(
+            draws,
+            [expect(5, 10), expect(5, 13), expect(6, 10), expect(6, 13)]
+        );
+        assert_eq!(PrimitiveSplit::plan(s).unwrap().len(), 4);
+    }
+
+    /// The guest draws this rung was built for: a quad as an indexed
+    /// six-element triangle list and as a four-element strip, cull none, fill.
+    #[test]
+    fn the_guest_quad_shapes_are_admitted() {
+        let draws = |topology, elements| PrimitiveSplit::plan(shape(topology, elements));
+        assert_eq!(draws(PrimitiveType::Triangle, 6).unwrap().len(), 2);
+        assert_eq!(draws(PrimitiveType::Triangle, 168).unwrap().len(), 56);
+        assert_eq!(draws(PrimitiveType::TriangleStrip, 4).unwrap().len(), 2);
+    }
+
+    /// A built-in the split changes is a refusal, named, and only where the
+    /// split changes it: a single primitive draw is the original draw.
+    #[test]
+    fn a_split_observable_builtin_refuses_by_name() {
+        let reads = |reads: SplitReads| DrawShape {
+            reads,
+            ..shape(PrimitiveType::Triangle, 6)
+        };
+        assert_eq!(
+            decline(PrimitiveSplit::plan(reads(SplitReads {
+                primitive_id: true,
+                ..Default::default()
+            }))),
+            ColorInputDecline::UnorderedBuiltinObservable {
+                builtin: SplitBuiltin::PrimitiveId
+            }
+        );
+        let one = DrawShape {
+            reads: SplitReads {
+                primitive_id: true,
+                ..Default::default()
+            },
+            ..shape(PrimitiveType::Triangle, 3)
+        };
+        assert!(PrimitiveSplit::plan(one).is_ok());
+        // BaseVertex moves only with a non-indexed split.
+        let base_vertex = SplitReads {
+            base_vertex: true,
+            ..Default::default()
+        };
+        assert!(PrimitiveSplit::plan(reads(base_vertex)).is_ok());
+        assert_eq!(
+            decline(PrimitiveSplit::plan(DrawShape {
+                indexed: false,
+                ..reads(base_vertex)
+            })),
+            ColorInputDecline::UnorderedBuiltinObservable {
+                builtin: SplitBuiltin::BaseVertex
+            }
+        );
+        // BaseInstance moves only when there is more than one instance.
+        let base_instance = SplitReads {
+            base_instance: true,
+            ..Default::default()
+        };
+        assert!(PrimitiveSplit::plan(reads(base_instance)).is_ok());
+        assert_eq!(
+            decline(PrimitiveSplit::plan(DrawShape {
+                instances: 2,
+                ..reads(base_instance)
+            })),
+            ColorInputDecline::UnorderedBuiltinObservable {
+                builtin: SplitBuiltin::BaseInstance
+            }
+        );
+    }
+
+    /// An odd strip triangle drawn alone has the opposite winding. That is
+    /// invisible unless something reads facing, so the refusal names which.
+    #[test]
+    fn a_strip_refuses_only_where_its_reversed_triangles_could_be_seen() {
+        let strip = shape(PrimitiveType::TriangleStrip, 4);
+        let term = |s: DrawShape| match decline(PrimitiveSplit::plan(s)) {
+            ColorInputDecline::UnorderedStripFacing { term } => term,
+            other => panic!("{other:?}"),
+        };
+        assert_eq!(
+            term(DrawShape {
+                culls: true,
+                ..strip
+            }),
+            FacingTerm::Cull
+        );
+        assert_eq!(
+            term(DrawShape {
+                two_sided_stencil: true,
+                ..strip
+            }),
+            FacingTerm::TwoSidedStencil
+        );
+        assert_eq!(
+            term(DrawShape {
+                reads: SplitReads {
+                    front_facing: true,
+                    ..Default::default()
+                },
+                ..strip
+            }),
+            FacingTerm::FrontFacingRead
+        );
+        // A one-triangle strip has no odd triangle, and a list never reverses.
+        let culled = |s: DrawShape| DrawShape { culls: true, ..s };
+        assert!(PrimitiveSplit::plan(culled(shape(PrimitiveType::TriangleStrip, 3))).is_ok());
+        assert!(PrimitiveSplit::plan(culled(shape(PrimitiveType::Triangle, 6))).is_ok());
+    }
+
+    /// Wireframe triangles cover their vertices with two edges each, so one
+    /// primitive is not single-coverage and no split makes it ordered.
+    #[test]
+    fn wireframe_triangles_refuse_and_lines_do_not() {
+        let wire = |topology, elements| DrawShape {
+            wireframe: true,
+            ..shape(topology, elements)
+        };
+        assert_eq!(
+            decline(PrimitiveSplit::plan(wire(PrimitiveType::Triangle, 3))),
+            ColorInputDecline::UnorderedWireframe
+        );
+        assert!(PrimitiveSplit::plan(wire(PrimitiveType::Line, 4)).is_ok());
+    }
+
+    /// The expansion is bounded, and the refusal carries the count.
+    #[test]
+    fn the_expansion_is_bounded_and_names_its_size() {
+        let cap = MAX_PRIMITIVE_DRAWS as u32;
+        let at = shape(PrimitiveType::Triangle, 3 * cap);
+        assert!(PrimitiveSplit::plan(at).is_ok());
+        let over = shape(PrimitiveType::Triangle, 3 * (cap + 1));
+        assert_eq!(
+            decline(PrimitiveSplit::plan(over)),
+            ColorInputDecline::UnorderedSplitLimit {
+                draws: MAX_PRIMITIVE_DRAWS + 1,
+                limit: MAX_PRIMITIVE_DRAWS
+            }
+        );
+    }
+
+    /// The barrier is the pass's own self-dependency: same stages, same
+    /// accesses, so recording it inside the pass is valid by construction.
+    #[test]
+    fn the_barrier_scope_is_the_fetch_dependency_scope() {
+        assert_eq!(
+            INPUT_ORDER_SRC,
+            (
+                vk::PipelineStageFlags::COLOR_ATTACHMENT_OUTPUT,
+                vk::AccessFlags::COLOR_ATTACHMENT_WRITE
+            )
+        );
+        assert_eq!(
+            INPUT_ORDER_DST,
+            (
+                vk::PipelineStageFlags::FRAGMENT_SHADER,
+                vk::AccessFlags::INPUT_ATTACHMENT_READ
+            )
+        );
+    }
+}
