+    /// Found on a variable and on a block member, and only for the built-in
+    /// asked about: `FrontFacing` on a member is not `PrimitiveId`.
+    #[test]
+    fn a_builtin_is_found_on_a_variable_and_on_a_block_member() {
+        let decorated = module(&[(4 << 16) | 71, 1, 11, BUILTIN_PRIMITIVE_ID]);
+        assert!(declares_builtin(&decorated, BUILTIN_PRIMITIVE_ID));
+        assert!(!declares_builtin(&decorated, BUILTIN_FRONT_FACING));
+        let member = module(&[(5 << 16) | 72, 2, 0, 11, BUILTIN_FRONT_FACING]);
+        assert!(declares_builtin(&member, BUILTIN_FRONT_FACING));
+        assert!(!declares_builtin(&member, BUILTIN_PRIMITIVE_ID));
+        // A binding decoration whose literal happens to equal a built-in's
+        // number is not that built-in.
+        let binding = module(&[(4 << 16) | 71, 1, DECORATION_BINDING, BUILTIN_PRIMITIVE_ID]);
+        assert!(!declares_builtin(&binding, BUILTIN_PRIMITIVE_ID));
+    }
