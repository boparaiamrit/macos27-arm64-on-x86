FROM debian:trixie-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    gdb-multiarch \
    libbz2-1.0 \
    libdrm2 \
    libegl1 \
    libelf1t64 \
    libexpat1 \
    libfdt1 \
    libfontconfig1 \
    libgcc-s1 \
    libglib2.0-0t64 \
    libgmp10 \
    libhogweed6t64 \
    libnettle8t64 \
    libpixman-1-0 \
    libpng16-16t64 \
    libslirp0 \
    libstdc++6 \
    libvulkan1 \
    libwayland-client0 \
    libx11-6 \
    libx11-xcb1 \
    libxcb-dri3-0 \
    libxcb-present0 \
    libxcb-randr0 \
    libxcb-shape0 \
    libxcb-shm0 \
    libxcb-sync1 \
    libxcb-xfixes0 \
    libxcb1 \
    libxcursor1 \
    libxi6 \
    libxinerama1 \
    libxkbcommon-x11-0 \
    libxkbcommon0 \
    libxrandr2 \
    libxshmfence1 \
    libz3-4 \
    libzstd1 \
    llvm \
    mesa-vulkan-drivers \
    nbdkit \
    nbdkit-plugin-python \
    procps \
    python3 \
    python3-libnbd \
    python3-lz4 \
    python3-requests \
    qemu-utils \
    spirv-tools \
    zlib1g \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY --chmod=755 ctx/lib/ /opt/gpu-dzn/lib/
COPY --chmod=755 ctx/bin/ /opt/gpu-dzn/bin/
COPY --chmod=644 ctx/dzn_icd.json /opt/gpu-dzn/dzn_icd.json
